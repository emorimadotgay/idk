-- Highest owned zone in this world that the rebirth rule lets us stand in.
local farmZoneSig = ""
local function computeFarmZone(save)
    local unlocked = type(save.UnlockedZones) == "table" and save.UnlockedZones or {}
    local count = 0
    for _ in pairs(unlocked) do count += 1 end
    local sig = string.format("%d:%s:%s", count, tostring(save.Rebirths), tostring(state.world))
    if sig == farmZoneSig and state.farmZone then return state.farmZone end
    local list = {}
    for id, owned in pairs(unlocked) do
        local z = owned and zoneDir(id)
        if z and (state.world == nil or z.WorldNumber == state.world) then
            list[#list + 1] = { id = id, n = tonumber(z.ZoneNumber) or 0 }
        end
    end
    table.sort(list, function(a, b) return a.n > b.n end)
    local pick = nil
    for _, e in ipairs(list) do
        local ok = true
        if isfn(G.ZoneCmds, "MeetsRequirement") then ok = gv(G.ZoneCmds.MeetsRequirement, e.id) ~= false end
        if ok then pick = e.id break end
    end
    farmZoneSig = sig
    return pick
end

local breakPartCache = { zone = nil, part = nil }
-- A zone can have several BREAK_ZONE parts (Tech Spawn: main area + VIP area, verified live). The first
-- part found was the VIP one, so non-VIP accounts stood among piles they cannot break. Pick the part
-- holding the most non-VIP breakables; cache only once breakables have loaded.
local function breakPart(zoneId)
    local cached = breakPartCache.zone == zoneId and breakPartCache.part
    if cached and cached.Parent then return cached end
    if not isfn(G.ZonesUtil, "GetBreakableZones") then return nil end
    local bz = gv(G.ZonesUtil.GetBreakableZones, zoneId)
    if typeof(bz) ~= "Instance" then return nil end
    local parts = {}
    for _, d in ipairs(bz:GetDescendants()) do
        if d:IsA("BasePart") then parts[#parts + 1] = { part = d, n = 0 } end
    end
    if #parts == 0 then return nil end
    if #parts == 1 then
        breakPartCache.zone, breakPartCache.part = zoneId, parts[1].part
        return parts[1].part
    end
    local things = workspace:FindFirstChild("__THINGS")
    local folder = things and things:FindFirstChild("Breakables")
    local counted = 0
    for _, m in ipairs(folder and folder:GetChildren() or {}) do
        if m:IsA("Model") and m:GetAttribute("ParentID") == zoneId and m:GetAttribute("AreaID") ~= "VIP" then
            local ok, pos = pcall(function() return m:GetPivot().Position end)
            if ok then
                for _, e in ipairs(parts) do
                    local rel = e.part.CFrame:PointToObjectSpace(pos)
                    if math.abs(rel.X) <= e.part.Size.X / 2 and math.abs(rel.Z) <= e.part.Size.Z / 2 then
                        e.n += 1
                        counted += 1
                        break
                    end
                end
            end
        end
    end
    table.sort(parts, function(a, b) return a.n > b.n end)
    if counted > 0 then breakPartCache.zone, breakPartCache.part = zoneId, parts[1].part end
    return parts[1].part
end

-- EggsUtil.GetEggPosition reads ReplicatedStorage.ZoneEggIndex, which has no entry for some eggs
-- (verified live: 40 Zebra Egg). The egg capsule model is the fallback. World 3 uses neither (both empty,
-- verified live): its capsules stream into __THINGS.Eggs.World3 as "<n> - Egg Capsule" only while the
-- player is near, so every capsule seen is remembered; stepHatch visits the egg's zone for a missing one.
local eggPosition
do
    local function liveCapsule(n)
        local things = workspace:FindFirstChild("__THINGS")
        local eggs = things and things:FindFirstChild("Eggs")
        if not eggs then return nil end
        local name = string.format("%d - Egg Capsule", n)
        for _, w in ipairs(eggs:GetChildren()) do
            local cap = w:FindFirstChild(name)
            if cap then
                local c = cap:FindFirstChild("Center")
                local part = (c and c:IsA("BasePart") and c) or cap:FindFirstChildWhichIsA("BasePart", true)
                if part then return part.Position end
            end
        end
        return nil
    end

    eggPosition = function(n)
        if type(n) ~= "number" then return nil end
        local pos = isfn(G.EggsUtil, "GetEggPosition") and gv(G.EggsUtil.GetEggPosition, n) or nil
        if typeof(pos) == "Vector3" then return pos end
        local part = isfn(G.EggsUtil, "GetEggPart") and gv(G.EggsUtil.GetEggPart, n) or nil
        if typeof(part) == "Instance" and part:IsA("BasePart") then return part.Position end
        local key = n .. "@" .. tostring(game.PlaceId)
        local live = liveCapsule(n)
        if live then
            eggSeen[key] = { live.X, live.Y, live.Z }
            return live
        end
        local seen = eggSeen[key]
        if seen then return Vector3.new(seen[1], seen[2], seen[3]) end
        return nil
    end
end

-- Break-zone center, or while hatching the break-zone point nearest the egg: farming and hatching
-- from one spot instead of flying to the egg and back for every batch.
local function standPosition(zoneId)
    local part = breakPart(zoneId)
    if part then
        local h = state.plan and state.plan.hatch
        local eggPos = h and h.egg and eggPosition(h.egg.n)
        if typeof(eggPos) == "Vector3" then
            local cf, size = part.CFrame, part.Size
            local rel = cf:PointToObjectSpace(eggPos)
            local hx, hz = math.max(0, size.X / 2 - 6), math.max(0, size.Z / 2 - 6)
            local p = cf:PointToWorldSpace(Vector3.new(math.clamp(rel.X, -hx, hx), 0, math.clamp(rel.Z, -hz, hz))) + Vector3.new(0, 4, 0)
            if (p - eggPos).Magnitude <= 250 then return p end -- egg belongs to this area
        end
        return part.Position + Vector3.new(0, 4, 0)
    end
    if isfn(G.ZonesUtil, "GetTeleportPartLocation") then
        local cf = gv(G.ZonesUtil.GetTeleportPartLocation, zoneId)
        if typeof(cf) == "CFrame" then return cf.Position + Vector3.new(0, 3, 0) end
    end
    return nil
end


-- The game's own zone teleport (same request as the teleport menu): server-authoritative, lands on the zone pad.
local function serverZoneTeleport(zoneId)
    if not zoneId or not ready("serverZoneTp", 8) then return false end
    state.zoneTpAt = os.clock() -- the server moves the character some time after this; hatching waits it out
    local ok, res, msg = netInvoke("Teleports_RequestTeleport", zoneId)
    if ok and res then return true end
    log("zone teleport %s refused: %s", tostring(zoneId), tostring(msg or res))
    return false
end

local lastEnsure = 0
-- Keeps the character in the farm zone. Changing zone goes through the game's zone teleport first,
-- then a short in-zone hop to the break area. CFrame alone is the fallback.
local function ensureInZone()
    if state.busy or state.worldSwitching then return end
    local t = os.clock()
    if not state.forceEnsure and t - lastEnsure < 3 then return end
    lastEnsure = t
    state.forceEnsure = false
    if inInstance() then return end
    local zoneId = state.farmZone
    if not zoneId then return end
    local hrp = getHRP()
    if not hrp then return end
    local cz = isfn(G.MapCmds, "GetCurrentZone") and gv(G.MapCmds.GetCurrentZone) or nil
    if cz ~= nil and cz ~= zoneId and serverZoneTeleport(zoneId) then
        lastEnsure = os.clock() - 2 -- settle on the pad, then hop into the break area next tick
        return
    end
    local pos = standPosition(zoneId)
    if not pos then
        serverZoneTeleport(zoneId) -- zone folder not streamed in yet
        return
    end
    state.standPos = pos
    if (hrp.Position - pos).Magnitude > CONFIG.ZoneTolerance or (cz ~= nil and cz ~= zoneId) then
        moveTo(pos)
    end
end

-- Machine position in an owned zone of this world (MachineCmds.All never yields, GetAll can).
local machinePosition, rememberMachines
do
    local function livePosition(m)
        local ok, pos = pcall(function()
            if m.InteractPart and m.InteractPart.Parent then return m.InteractPart.Position end
            if m.Pad and m.Pad.pad then return m.Pad.pad:GetPivot().Position end
            if m.Model and m.Model.Parent then return m.Model:GetPivot().Position end
            return nil
        end)
        return ok and typeof(pos) == "Vector3" and pos or nil
    end

    -- first loaded machine of each name in an owned zone -> machineSeen (cheap table walk, brain calls it)
    rememberMachines = function()
        if not isfn(G.MachineCmds, "All") then return end
        local all = gv(G.MachineCmds.All)
        if type(all) ~= "table" then return end
        local save = getSave()
        local unlocked = save and type(save.UnlockedZones) == "table" and save.UnlockedZones or {}
        for name, list in pairs(all) do
            if type(name) == "string" and type(list) == "table" then
                for _, m in pairs(list) do
                    local zone = type(m) == "table" and type(m.ParentID) == "string" and m.ParentID or nil
                    if type(m) == "table" and (zone == nil or unlocked[zone]) then
                        local pos = livePosition(m)
                        if pos then
                            machineSeen[name .. "@" .. tostring(game.PlaceId)] = { pos.X, pos.Y, pos.Z, zone }
                            break
                        end
                    end
                end
            end
        end
    end

    machinePosition = function(name)
        if isfn(G.MachineCmds, "All") then
            local all = gv(G.MachineCmds.All)
            local list = type(all) == "table" and all[name] or nil
            local save = getSave()
            local unlocked = save and type(save.UnlockedZones) == "table" and save.UnlockedZones or {}
            for _, m in pairs(type(list) == "table" and list or {}) do
                if type(m) == "table" and not (type(m.ParentID) == "string" and not unlocked[m.ParentID]) then
                    local pos = livePosition(m)
                    if pos then return pos end
                end
            end
        end
        local seen = machineSeen[name .. "@" .. tostring(game.PlaceId)]
        if seen then return Vector3.new(seen[1], seen[2], seen[3]), true end -- true = remembered, not loaded
        return nil
    end
end

-- Strikes: an action that keeps failing stops costing trips (60 s, 5 min, 30 min; 1 h when the server
-- says VIP / gamepass / rebirth, which a retry will not fix).
local strikes = {}
local function isBlocked(key)
    local s = strikes[key]
    return s ~= nil and os.clock() < s.untilT
end
local function strike(key, msg)
    local s = strikes[key] or { n = 0, untilT = 0 }
    s.n += 1
    local m = string.lower(tostring(msg or ""))
    -- refusals no in-game action fixes (live: "join all big games groups", "please verify on the sign first!")
    local hard = string.find(m, "vip", 1, true) or string.find(m, "gamepass", 1, true) or string.find(m, "rebirth", 1, true)
        or string.find(m, "group", 1, true) or string.find(m, "verify", 1, true)
        or string.find(m, "don't own", 1, true) -- machine in a zone not owned yet (live, World 2 egg slots)
    s.untilT = os.clock() + (hard and 3600 or ({ 60, 300, 1800 })[math.min(s.n, 3)])
    strikes[key] = s
    log("strike %s (%d): %s", key, s.n, m)
end
local function clearStrike(key) strikes[key] = nil end

local vipCache = { at = -1e9, v = false }
local function ownsVip()
    if os.clock() - vipCache.at < 60 then return vipCache.v end
    vipCache.at = os.clock()
    vipCache.v = isfn(G.Gamepasses, "Owns") and gv(G.Gamepasses.Owns, "VIP") == true
    return vipCache.v
end
local function vipAllowed(text)
    if string.find(string.lower(tostring(text or "")), "vip", 1, true) then return ownsVip() end
    return true
end

-- The game's own machine rules (Shared.Variables) + VIP + strikes, checked before any trip.
local function machineAllowed(name)
    if isBlocked("machine:" .. name) or not vipAllowed(name) then return false end
    local sv, save = G.SharedVariables, getSave()
    if type(sv) == "table" and save then
        local zone = type(sv.MACHINE_REQUIRED_ZONES) == "table" and sv.MACHINE_REQUIRED_ZONES[name] or nil
        if zone and not (type(save.UnlockedZones) == "table" and save.UnlockedZones[zone]) then return false end
        local reb = type(sv.MACHINE_REQUIRED_REBIRTHS) == "table" and tonumber(sv.MACHINE_REQUIRED_REBIRTHS[name]) or nil
        if reb and (tonumber(save.Rebirths) or 0) < reb then return false end
    end
    return true
end

-- Runs fn next to the named machine when the game's own CanUse check says we are too far.
-- Without a known machine position fn still runs (the server is the final judge).
local function withMachine(name, fn, ...)
    if not machineAllowed(name) then return nil end
    -- same race as hatching: a zone teleport still landing pulls us off the machine (live: refusals right after boot)
    local sinceTp = os.clock() - (state.zoneTpAt or -1e9)
    if sinceTp < 6 then task.wait(6 - sinceTp) end
    local near = isfn(G.MachineCmds, "CanUse") and gv(G.MachineCmds.CanUse, name) == true
    local hopped = false
    if not near then
        local pos, remembered = machinePosition(name)
        if pos then
            state.busy = true
            hopped = moveTo(pos + Vector3.new(0, 3, 0))
            if remembered then
                -- a remembered machine streams in only once we stand there: wait for the game's own CanUse
                local t0 = os.clock()
                repeat task.wait(0.25)
                until os.clock() - t0 > 2.5 or (isfn(G.MachineCmds, "CanUse") and gv(G.MachineCmds.CanUse, name) == true)
            else
                task.wait(0.35)
            end
        end
    end
    local r = table.pack(pcall(fn, ...))
    if hopped or state.busy then
        state.busy = false
        state.forceEnsure = true
    end
    if not r[1] then return nil end
    return table.unpack(r, 2, r.n)
end

local function setDoing(text)
    state.doing = text
    state.doingAt = os.clock()
end

