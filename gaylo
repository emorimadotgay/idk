    if rSig ~= rankSig then
        rankSig = rSig
        if info then
            setText(GUI.rankLine, string.format(
                '<font color="#8997a8">RANK</font> <font color="#e4eef9">%s %s</font>   <font color="#37424f">·</font>   <font color="#8997a8">STARS</font> <font color="#a4c9f4">%s/%s</font>   <font color="#37424f">·</font>   <font color="#8997a8">REWARDS</font> <font color="#e4eef9">%s/%s</font>',
                int(info.rankNumber), esc(short(info.title, 18)), int(info.stars), int(info.totalStars),
                int(info.redeemedCount), int(#info.rewards)))
        else
            setText(GUI.rankLine, '<font color="#566473">RANK loading...</font>')
        end
    end

    setText(GUI.step, '<font color="#566473">STEP</font>   <font color="#8997a8">' .. esc(short(state.action, 150)) .. "</font>")

    setText(GUI.tasks, buildTaskLine())
end

