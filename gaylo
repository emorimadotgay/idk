local function readStateFile()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return nil end
    local ok, data = pcall(function()
        if not isfile(STATE_FILE) then return nil end
        local raw = readfile(STATE_FILE)
        if type(raw) ~= "string" or raw == "" then return nil end
        return HttpService:JSONDecode(raw)
    end)
    if ok and type(data) == "table" then return data end
    return nil
end

local function writeStateFile()
    if type(writefile) ~= "function" then return end
    pcall(function()
        local payload = {
            version = VERSION,
            savedAt = os.time(),
            lastWorldSwitch = state.persist.lastWorldSwitch or 0,
            counters = state.counters,
        }
        writefile(STATE_FILE, HttpService:JSONEncode(payload))
    end)
end
persistHook = writeStateFile

local function restoreStateFile()
    local data = readStateFile()
    if not data then return end
    state.persist.lastWorldSwitch = tonumber(data.lastWorldSwitch) or 0
    local savedAt = tonumber(data.savedAt) or 0
    if type(data.counters) == "table" and os.time() - savedAt < STATE_FILE_MAX_AGE then
        for k, v in pairs(data.counters) do
            if type(v) == "number" and state.counters[k] ~= nil then
                state.counters[k] = v
            end
        end
    end
end

-- Queue this script to run again after the next place teleport.
local function queueSelf(verbose)
    if state.queued then return true end
    if type(queue_on_teleport) ~= "function" then
        if verbose then
        end
        return false
    end
    local function serializeCfgValue(v, depth)
        local t = type(v)
        if t == "boolean" or t == "number" then
            return tostring(v)
        elseif t == "string" then
            return string.format("%q", v)
        elseif t == "table" and (depth or 0) < 3 then
            local parts = {}
            local isArray = true
            for k in pairs(v) do
                if type(k) ~= "number" then
                    isArray = false
                    break
                end
            end
            if isArray then
                for i = 1, #v do
                    local s = serializeCfgValue(v[i], (depth or 0) + 1)
                    if s then parts[#parts + 1] = s end
                end
                return "{" .. table.concat(parts, ",") .. "}"
            end
            for k, vv in pairs(v) do
                if type(k) == "string" and string.match(k, "^[%a_][%w_]*$") then
                    local s = serializeCfgValue(vv, (depth or 0) + 1)
                    if s then parts[#parts + 1] = k .. "=" .. s end
                end
            end
            return "{" .. table.concat(parts, ",") .. "}"
        end
        return nil
    end
    local okSer, cfgPrefix = pcall(function()
        local parts = {}
        for k, v in pairs(CONFIG) do
            if type(k) == "string" then
                local s = serializeCfgValue(v, 0)
                if s then parts[#parts + 1] = k .. "=" .. s end
            end
        end
        return "getgenv().MuradAutoRankConfig={" .. table.concat(parts, ",") .. "};"
    end)
    local prefix = (okSer and type(cfgPrefix) == "string") and cfgPrefix or ""
    local src = nil
    if type(CONFIG.ReexecSource) == "string" and #CONFIG.ReexecSource > 0 then
        src = prefix .. CONFIG.ReexecSource
    elseif type(CONFIG.WorkspaceFile) == "string" and type(isfile) == "function" then
        local ok, exists = pcall(isfile, CONFIG.WorkspaceFile)
        if ok and exists then
            src = prefix .. string.format(
                'pcall(function() local f, e = loadstring(readfile(%q)); assert(f, e); f() end)',
                CONFIG.WorkspaceFile)
        end
    end
    if not src then
        if verbose then
        end
        return false
    end
    local ok, err = pcall(queue_on_teleport, src)
    if ok then
        state.queued = true
    else
    end
    return ok
end

