    -- Map strip (local only). Every zone folder is PARTS / PARTS_LOD (geometry), PERSISTENT (teleport pad)
    -- and INTERACT (break zones, gate, machines). Geometry goes; PERSISTENT and INTERACT stay, and so does
    -- __THINGS.__FAKE_GROUND (invisible, CanCollide): the character keeps standing on it and MapCmds keeps
    -- detecting zones with it. SHOP is kept whole (the spawn locations live in SHOP.PARTS).
    installMapStrip = function()
        if not CONFIG.OptimizeMap then return end
        local ZONE_STRIP = { PARTS = true, PARTS_LOD = true }
        local INTERACT_STRIP = { Statues = true, Fanart = true, ["Like Signs"] = true }
        local KEEP_ZONE = { SHOP = true }
        local function strip(inst)
            if inst and inst.Parent then pcall(inst.Destroy, inst) end
        end
        local function stripZone(folder)
            if KEEP_ZONE[folder.Name] then return end
            for _, ch in ipairs(folder:GetChildren()) do
                if ZONE_STRIP[ch.Name] then
                    strip(ch)
                elseif ch.Name == "INTERACT" then
                    for _, d in ipairs(ch:GetChildren()) do
                        if INTERACT_STRIP[d.Name] then strip(d) end
                    end
                end
            end
            -- LOD swaps / late loads re-add geometry
            track(folder.ChildAdded:Connect(function(ch)
                if ZONE_STRIP[ch.Name] then task.defer(strip, ch) end
            end))
        end
        task.spawn(function()
            for _, name in ipairs({ "Border", "FlyBorder", "PSX Hall", "PSX Portal" }) do
                strip(workspace:FindFirstChild(name))
            end
            pcall(function() workspace.Terrain:Clear() end)
            for _, map in ipairs(workspace:GetChildren()) do
                if map:IsA("Folder") and string.match(map.Name, "^Map%d*$") then
                    for _, zone in ipairs(map:GetChildren()) do
                        if not state.alive then return end
                        if zone:IsA("Folder") then
                            stripZone(zone)
                            task.wait() -- one zone per frame: no single huge hitch
                        end
                    end
                    track(map.ChildAdded:Connect(function(zone)
                        if zone:IsA("Folder") then
                            task.delay(1, function() if state.alive then stripZone(zone) end end)
                        end
                    end))
                end
            end
            state.forceEnsure = true -- re-seat on the invisible ground straight away
            log("map stripped")
        end)
    end

    -- =====================================================================================
    -- 16. Stability: anti-AFK, rejoin, teleport failures
    -- =====================================================================================
    installAntiAfk = function()
        if getConns then
            pcall(function()
                for _, c in ipairs(getConns(LocalPlayer.Idled)) do
                    pcall(function() if c.Disable then c:Disable() else c:Disconnect() end end)
                end
            end)
        end
        track(LocalPlayer.Idled:Connect(function()
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end))
    end

    rejoin = function(reason)
        if not CONFIG.AutoRejoin or state.rejoining or not state.alive then return end
        state.rejoining = true
        log("rejoin: %s", tostring(reason))
        persist()
        queueSelf()
        task.spawn(function()
            task.wait(3)
            while state.alive do
                pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
                task.wait(30)
            end
        end)
    end

    installRejoin = function()
        track(GuiService.ErrorMessageChanged:Connect(function(msg)
            if type(msg) == "string" and msg ~= "" and not state.worldSwitching then rejoin("error: " .. msg) end
        end))
        pcall(function()
            local overlay = CoreGui:FindFirstChild("RobloxPromptGui")
            overlay = overlay and overlay:FindFirstChild("promptOverlay")
            if overlay then
                track(overlay.ChildAdded:Connect(function(child)
                    if child.Name == "ErrorPrompt" and not state.worldSwitching then rejoin("error prompt") end
                end))
            end
        end)
        track(TeleportService.TeleportInitFailed:Connect(function(plr, result, msg)
            if plr ~= LocalPlayer then return end
            log("teleport failed: %s %s", tostring(result), tostring(msg))
            if state.worldSwitching then
                state.worldSwitching = false
                state.lastWorldSwitch = 0
            end
        end))
    end

end

