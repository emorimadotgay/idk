local buildGui, refreshGui
do
    local ROW_COUNT = 8
    local MONO = "rbxasset://fonts/families/RobotoMono.json"

    local function setFont(label, bold)
        local ok = pcall(function()
            label.FontFace = Font.new(MONO, bold and Enum.FontWeight.Bold or Enum.FontWeight.Regular)
        end)
        if not ok then label.Font = Enum.Font.Code end
    end

    -- Containers in the order we try them. Some executors' gethui() hands back a folder that never
    -- renders, and low-identity executors cannot parent into CoreGui at all.
    local function guiParents()
        local list = {}
        if getHui then
            local ok, h = pcall(getHui)
            if ok and typeof(h) == "Instance" then list[#list + 1] = { h, "gethui" } end
        end
        if CoreGui then list[#list + 1] = { CoreGui, "CoreGui" } end
        local lp = Players and Players.LocalPlayer
        local pg = lp and (lp:FindFirstChildOfClass("PlayerGui") or lp:WaitForChild("PlayerGui", 10))
        if pg then list[#list + 1] = { pg, "PlayerGui" } end
        return list
    end

    -- parents sg and returns the container name once the screen frame has a real on-screen size
    local function mountGui(sg, screen)
        for _, entry in ipairs(guiParents()) do
            local ok = pcall(function() sg.Parent = entry[1] end)
            if ok and sg.Parent == entry[1] then
                task.wait() -- one frame for layout
                local okSize, size = pcall(function() return screen.AbsoluteSize end)
                if not okSize or typeof(size) ~= "Vector2" or size.X > 0 then return entry[2] end
            end
        end
        return nil
    end

    local function setScreen(visible)
        if not gui then return end
        GUI.screen.Visible = visible
        if GUI.toggle then GUI.toggle.Visible = not visible end -- the H button only shows while the game is visible
        if CONFIG.Disable3DRendering then setRendering(not visible) end
    end

    buildGui = function()
        if not CONFIG.ShowGui then return end
        local ok, err = pcall(function()
            local sg = Instance.new("ScreenGui")
            sg.Name = "Hayami"
            sg.ResetOnSpawn = false
            sg.IgnoreGuiInset = true
            sg.DisplayOrder = 999999
            sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
