    end
    return false
end

local function farmTick()
    if not CONFIG.AutoFarm then return end
    if state.worldSwitching or state.worldMismatch then return end
    if inInstance() then return end
    ensureInBestZone()
    local zoneId = bestZoneId()
    if not zoneId then return end
    local pets = petEuids()
    state.farmPets = #pets
    if #pets == 0 then
        -- only consult GetEquipped/EquipBest when the farm loop's own verified pet view
        -- (PlayerPet.GetAll + BelongsToLocalPlayer) shows no local pets
        maybeEquipBest()
        return
    end
    local p1, p2, p3 = collectBreakables(zoneId)
    local targets, tier
    if #p1 > 0 then
        targets, tier = p1, 1
    elseif #p2 > 0 and wantsDiamonds() then
        targets, tier = p2, 2
    else
        targets = {}
        for _, u in ipairs(p2) do targets[#targets + 1] = u end
        for _, u in ipairs(p3) do targets[#targets + 1] = u end
        tier = 3
    end
    if #targets == 0 then
        local q1, q2, q3 = collectBreakablesAny()
        if #q1 > 0 then
            targets, tier = q1, 1
        elseif #q2 > 0 and wantsDiamonds() then
            targets, tier = q2, 2
        else
            targets = {}
            for _, u in ipairs(q2) do targets[#targets + 1] = u end
            for _, u in ipairs(q3) do targets[#targets + 1] = u end
            tier = 3
        end
    end
    state.farmTargets = #targets
    if #targets == 0 then return end
    if tier < state.farmLastTier then
        breakAssign = {} -- a higher-priority target appeared: reshuffle everyone
    end
    state.farmLastTier = tier

    local live, used, petSet = {}, {}, {}
    for _, u in ipairs(targets) do live[u] = true end
    for _, e in ipairs(pets) do petSet[e] = true end
    for e, u in pairs(breakAssign) do
        if live[u] and petSet[e] then
            used[u] = true
        else
            breakAssign[e] = nil
        end
    end
    local free = {}
    for _, u in ipairs(targets) do
        if not used[u] then free[#free + 1] = u end
    end
    local rr = 0
    local map = {}
    for _, e in ipairs(pets) do
        if breakAssign[e] == nil then
            if #free > 0 then
                breakAssign[e] = table.remove(free, 1)
            else
                rr += 1
                breakAssign[e] = targets[(rr - 1) % #targets + 1]
            end
        end
        map[e] = breakAssign[e]
    end
    if next(map) == nil then return end
    farmTargetList = targets
    local sigParts = {}
    for _, e in ipairs(pets) do
        sigParts[#sigParts + 1] = e .. "=" .. tostring(map[e])
    end
    local sig = table.concat(sigParts, "|")
    if sig ~= state.lastBulkSig then
        state.lastBulkSig = sig
        local ok, err = netFire("Breakables_JoinPetBulk", map)
        if ok then
            state.counters.farmTicks += 1
        else
        end
    end
end

local function tapTick()
    if not CONFIG.AutoFarm or not state.alive then return end
    if state.worldSwitching or state.worldMismatch then return end
    if inInstance() then return end
    local list = farmTargetList
    if #list == 0 then return end
    state.tapIndex = (state.tapIndex % #list) + 1
    local uid = list[state.tapIndex]
    if uid ~= nil then
        netUnreliable("Breakables_PlayerDealDamage", uid)
    end
end

-- Fast path: an event breakable (comet, chest, ...) appeared -> all pets on it immediately.
-- Cheap checks run inline; only a breakable whose attributes have not replicated yet is deferred one frame.
local function onBreakableAdded(m)
    if not (state.alive and CONFIG.AutoFarm) or state.worldSwitching or state.worldMismatch then return end
    if typeof(m) ~= "Instance" or not m:IsA("Model") then return end
    local zoneId = cache.zoneId or bestZoneId()
    if not zoneId then return end
    local function handle()
        local ok, err = pcall(function()
            if not state.alive or m.Parent == nil then return end
            if m:GetAttribute("ParentID") ~= zoneId then return end
            if classifyBreakable(m) ~= 1 then return end
            local uid = m:GetAttribute("BreakableUID")
            if uid == nil then return end
            if inInstance() then return end -- cached (1 s)
            local pets = petEuids()
            if #pets == 0 then return end
            local map = {}
            for _, e in ipairs(pets) do
                map[e] = uid
                breakAssign[e] = uid
            end
            state.farmLastTier = 1
            netUnreliable("Breakables_PlayerDealDamage", uid)
            netFire("Breakables_JoinPetBulk", map)
            state.counters.eventTargets += 1
        end)
    end
    if m:GetAttribute("ParentID") == nil then
        task.defer(handle) -- attributes may replicate a frame after the instance
    else
        handle()
    end
end

local function installBreakableListener()
    task.spawn(function()
        local folder = nil
        local t0 = os.clock()
        while state.alive and not folder and os.clock() - t0 < 180 do
            folder = breakablesFolder()
            if not folder then task.wait(1) end
        end
        if not folder or not state.alive then
            return
        end
        track(folder.ChildAdded:Connect(onBreakableAdded))
    end)
end

