local function eggIdForNumber(n)
    if type(G.Eggs) ~= "table" then return nil end
    for id, e in pairs(G.Eggs) do
        if type(id) == "string" and type(e) == "table" and tonumber(e.eggNumber) == n then
            return id
        end
