                t.Parent = footer
                return t
            end
            local hideBtn = footerText("TextButton", Enum.TextXAlignment.Left, 0, "Hide GUI", Color3.fromRGB(200, 200, 200))
            footerText("TextLabel", Enum.TextXAlignment.Center, 0.5, "RightCtrl toggle  \u{B7}  v" .. VERSION, Color3.fromRGB(85, 85, 85))
            local stopBtn = footerText("TextButton", Enum.TextXAlignment.Right, 1, "Stop Script", Color3.fromRGB(200, 200, 200))
            track(hideBtn.Activated:Connect(function() setScreen(false) end))
            track(stopBtn.Activated:Connect(function() Stop() end))

            -- brings the screen back once hidden (touch has no RightCtrl)
            local btn = Instance.new("TextButton")
            btn.Name = "Toggle"
            btn.AnchorPoint = Vector2.new(1, 0)
            btn.Position = UDim2.new(1, -12, 0, 12)
            btn.Size = UDim2.fromOffset(38, 38)
            btn.BackgroundColor3 = Color3.new(0, 0, 0)
            btn.BackgroundTransparency = 0.2
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.Text = "H"
            btn.TextSize = 18
            btn.AutoButtonColor = false
            btn.ZIndex = 10
            btn.Visible = false
            setFont(btn, true)
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = btn
            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.fromRGB(80, 80, 80)
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Parent = btn
            btn.Parent = sg
            GUI.toggle = btn
            track(btn.Activated:Connect(function() setScreen(true) end))

            track(UserInputService.InputBegan:Connect(function(input, processed)
                if processed then return end
                if input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.Insert then
                    setScreen(not screen.Visible)
                end
            end))

            gui = sg
            local where = mountGui(sg, screen)
            if where then
                print("[Hayami] screen mounted in " .. where)
            else
                report("gui", "no container would show the screen (gethui / CoreGui / PlayerGui)")
            end
        end)
        if not ok then report("gui", err) end
        if gui then setScreen(true) end
    end

    refreshGui = function()
        if not gui or not GUI.screen or not GUI.screen.Visible then return end
        if not state.ready then state.rows[3] = clock(os.clock() - state.bootClock) end -- timer ticks while loading
        for i = 1, ROW_COUNT do
            local v = state.rows[i]
            local l = GUI.labels[i]
            if v and l and GUI.text[i] ~= v then
                GUI.text[i] = v
                l.Text = v
            end
        end
    end

end

-- =====================================================================================
-- 18. Threads & boot
-- =====================================================================================
local function loop(name, interval, fn)
    task.spawn(function()
        while state.alive do
            local ok, err = pcall(fn)
            if not ok then
                report(name, err)
                task.wait(1)
            end
            if not state.alive then break end
            local iv = type(interval) == "function" and interval() or interval
            task.wait(math.max(0.03, tonumber(iv) or 1))
        end
    end)
end

local function workInterval()
    if state.plan.hatch and CONFIG.AutoHatch then
        local wait = state.hatchBackoff - os.clock()
        if wait > 0 then return math.min(wait, 2) end
        return CONFIG.HatchDelay
    end
    return 0.5
end

local function bootstrap()
    bootStage("waiting for the game to load")
    repeat task.wait(0.25) until game:IsLoaded() or not state.alive
    local t0 = os.clock()
    bootStage("waiting for the player")
    while state.alive and not Players.LocalPlayer do
        if os.clock() - t0 > 60 then return false, "no LocalPlayer after 60 s" end
        task.wait(0.5)
    end
    LocalPlayer = Players.LocalPlayer
    if not state.alive then return false, "stopped" end
    loadModules()
    local modCount = 0
    for _ in pairs(G) do modCount += 1 end
    print(string.format("[Hayami] game modules loaded: %d", modCount))
    if not G.Save then return false, "could not load Library.Client.Save (executor require blocked?)" end
    if not G.Network then return false, "could not load Library.Client.Network" end
    t0 = os.clock()
    bootStage("waiting for save data")
    while state.alive and getSave() == nil do
        if os.clock() - t0 > 90 then return false, "save data never loaded (Save.Get returned nothing for 90 s)" end
        task.wait(0.5)
    end
    t0 = os.clock()
    bootStage("waiting for the client to finish loading")
    while state.alive and os.clock() - t0 < 5 do
        local ok, loaded = pcall(function() return LocalPlayer:GetAttribute("__LOADED") end)
        if ok and loaded then break end
        task.wait(0.25)
    end
    return state.alive, "stopped"
end

bootStage = function(stage)
    state.bootStageText = stage
    if state.ready then return end
    state.task = "loading: " .. stage
    state.rows[1] = esc(CONFIG.ScreenTitle ~= "" and CONFIG.ScreenTitle or "Hayami")
    state.rows[3] = clock(os.clock() - state.bootClock)
    state.rows[7] = paint(C_LABEL, "STEP") .. " " .. paint(C_DIM, "loading: " .. stage)
end

local function main()
    local exec = "?"
    pcall(function()
        local f = rawget(genv, "identifyexecutor") or rawget(genv, "getexecutorname")
        if type(f) == "function" then exec = tostring((f())) end
    end)
    print(string.format("[Hayami] v%s starting | executor %s | identity %s | gethui %s | queue_on_teleport %s",
        VERSION, exec, tostring(EXEC_IDENTITY), getHui and "yes" or "no", queueTeleport and "yes" or "no"))
    -- the screen comes up first, so a stuck boot shows where it is stuck
    bootStage("starting")
    buildGui()
    loop("ui", 1, refreshGui)

    local ok, reason = bootstrap()
    if not ok then
        report("boot", reason)
        bootStage("failed - " .. tostring(reason))
        state.rows[7] = paint(C_LABEL, "STEP") .. " " .. paint("#FF6B6B", "boot failed: " .. tostring(reason))
        if state.alive and CONFIG.AutoRejoin and reason ~= "stopped" then
            task.wait(20)
            rejoin("boot failed: " .. tostring(reason))
        end
        return
    end
    bootStage("starting systems")
    restore()
    pcall(installRejoin)
    pcall(installAntiAfk)
    if CONFIG.InfinitePetSpeed then pcall(installSpeedHook) end
    if CONFIG.SuperMagnet then pcall(installMagnet) end
    if CONFIG.DisableHatchAnimation then pcall(installNoHatchAnimation) end
    pcall(installCpuSaver)
    pcall(installMapStrip)
    pcall(queueSelf)
    installBreakableRegistry()
    pcall(installFastCollect)
    if not state.alive then return end
    state.ready = true
    local okBrain, errBrain = pcall(brainTick)
    if not okBrain then report("brain", errBrain) end

    loop("brain", 1, brainTick)
    loop("farm", function() return (CONFIG.AutoFarm and not state.worldSwitching) and CONFIG.FarmTick or 1 end, function()
        farmStep()
        tapStep()
    end)
    loop("work", workInterval, function()
        -- watchdog(): a step parked in a remote invoke (no timeout) longer than 5 min forces a rejoin
        state.workSince = os.clock()
        workTick()
        state.workSince = nil
    end)
    -- a killed client (crash, app closed) never reaches persist() in rejoin/Stop; a ~200-byte write
    -- every 30 s caps what is lost and stays negligible across hundreds of instances
    loop("persist", 30, persist)
    print("[Hayami] v" .. VERSION .. " running")
end

task.spawn(function()
    -- a crash keeps the screen up with the reason (it used to call Stop() and vanish without a word)
    local ok, err = xpcall(main, debug.traceback)
    if not ok then
        report("main", err)
        if bootStage then bootStage("crashed - see console (F9)") end
    end
end)
