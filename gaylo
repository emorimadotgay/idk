local function installCpuSaver()
    if not CONFIG.CpuSaver then return end
    local cpuSaved = {}
    local applyProp, callMethod1, callMethod2 = nil, nil, nil
    if type(loadstring) == "function" then
        local fn1 = loadstring("local t, k, v = ...; t[k] = v; return true")
        if type(fn1) == "function" then applyProp = fn1 end
        local fn2 = loadstring("local t, k, a = ...; return t[k](t, a)")
        if type(fn2) == "function" then callMethod1 = fn2 end
        local fn3 = loadstring("local t, k, a, b = ...; return t[k](t, a, b)")
