local function buildPlan()
    local info = state.rank
    local plan = { hatch = false, hatchReasons = {}, hatchEggOnly = true, hatchRemaining = nil, crafting = false, waitingChest = false }
    local parts = {}
    local zone = bestZone()
    if state.worldSwitching then
        state.plan = plan
        state.action = string.format("teleporting to World %s", tostring(zone and zone.WorldNumber or "?"))
        return
    end
    if state.worldMismatch then
        parts[#parts + 1] = string.format("wrong world (best zone is in World %s)", tostring(zone and zone.WorldNumber or "?"))
    elseif info and info.isMax then
        parts[#parts + 1] = "max rank reached"
    elseif CONFIG.AutoFarm then
        local s = string.format("Farming %s (%s pets / %s targets)", tostring(bestZoneName()), int(state.farmPets), int(state.farmTargets))
        if state.counters.eventTargets > 0 then
            s = s .. string.format(", %s events caught", int(state.counters.eventTargets))
        end
        parts[#parts + 1] = s
    end
    for _, goal in ipairs(state.goals) do
        local t = goal.Type
        if goal.remaining > 0 then
            if HATCH_GOALS[t] and CONFIG.AutoHatch then
                plan.hatch = true
                table.insert(plan.hatchReasons, GOAL_TYPE_NAMES[t] or tostring(t))
                if EGG_COUNT_GOALS[t] then
                    plan.hatchRemaining = math.max(plan.hatchRemaining or 0, goal.remaining)
                else
                    plan.hatchEggOnly = false
                end
            elseif (GOLD_GOALS[t] or RAINBOW_GOALS[t]) and CONFIG.AutoCraftGoldRainbow and rankAllows(t) then
                plan.crafting = true
                parts[#parts + 1] = string.format("%s %s/%s", GOLD_GOALS[t] and "gold crafting" or "rainbow crafting", int(goal.Progress), int(goal.Amount))
            elseif EVENT_GOAL_KIND[t] and CONFIG.AutoSpawnEvents then
                local def = EVENT_DEFS[EVENT_GOAL_KIND[t]]
                parts[#parts + 1] = string.format("%s %s/%s", def.label, int(goal.Progress), int(goal.Amount))
            elseif CHEST_GOALS[t] and rankAllows(t) then
                plan.waitingChest = true
            elseif t == T_USE_POTION and CONFIG.AutoUsePotions then
                parts[#parts + 1] = string.format("potions T%s %s/%s", tostring(goalParam(goal, "PotionTier") or "?"), int(goal.Progress), int(goal.Amount))
            elseif t == T_UPGRADE_POTION and CONFIG.AutoUpgradePotions then
                parts[#parts + 1] = string.format("potion upgrades %s/%s", int(goal.Progress), int(goal.Amount))
            elseif t == T_UPGRADE_ENCHANT and CONFIG.AutoUpgradeEnchants then
                parts[#parts + 1] = string.format("enchant upgrades %s/%s", int(goal.Progress), int(goal.Amount))
            elseif t == T_USE_FRUIT and CONFIG.AutoUseFruits then
                parts[#parts + 1] = string.format("fruits %s/%s", int(goal.Progress), int(goal.Amount))
            elseif t == T_USE_FLAG and CONFIG.AutoUseFlags then
                parts[#parts + 1] = string.format("flags %s/%s", int(goal.Progress), int(goal.Amount))
            elseif t == T_ZONE and CONFIG.AutoBuyZones then
                parts[#parts + 1] = "buying zones"
            end
        end
    end
    local fodderOnly = false
    if state.craftHatchReason ~= nil and CONFIG.AutoHatch then
        fodderOnly = not plan.hatch
        plan.hatch = true
        plan.hatchEggOnly = false
        table.insert(plan.hatchReasons, state.craftHatchReason)
    end
    if CONFIG.AlwaysHatch and CONFIG.AutoHatch then
        plan.hatch = true
        plan.hatchEggOnly = false
        fodderOnly = false
    end
    if not plan.hatch then plan.hatchEggOnly = false end
    state.plan = plan
    if plan.hatch and not state.worldMismatch then
        local egg = cache.egg or bestEgg()
        parts[#parts + 1] = string.format("hatching %s x%s%s", tostring(egg and (egg.name or egg.id) or "best egg"), int(hatchAmount()),
            fodderOnly and " (fodder)" or "")
    end
    if plan.waitingChest then parts[#parts + 1] = "waiting for mini chest spawns" end
    if info and info.blockedByZone then
        parts[#parts + 1] = string.format("rank needs zone %s", tostring(info.zoneNumberNeeded or "?"))
    elseif info and info.blockedByRebirth then
        parts[#parts + 1] = string.format("rank needs %s rebirths (have %s)", tostring(info.rebirthsNeeded or "?"), int(info.rebirths))
    end
    if state.hopping then parts[#parts + 1] = "hopping to egg" end
    state.action = #parts > 0 and table.concat(parts, " | ") or "idle"
end

local function equippedSnapshot()
    local ok, cur = gcall(G.EnchantCmds.GetEquipped)
    if ok and type(cur) == "table" then return cur end
    return nil
end
local function handleEquipEnchants()
    local want = CONFIG.EquipEnchants
    if type(want) ~= "table" or #want == 0 then
        state.enchantStatus = "off"
        return
    end
    if not isfn(G.EnchantCmds, "Get") then
        state.enchantStatus = "no-mod"
        return
    end
    state.enchantStatus = "pass"
    local ids, seen = {}, {}
    local dirOk = type(G.Enchants) == "table"
    for _, raw in ipairs(want) do
        if type(raw) == "string" then
            local id = raw:match("^%s*(.-)%s*$")
            if id ~= "" and not seen[id] then
                if dirOk and G.Enchants[id] == nil then
                    local lower = id:lower()
                    for k in pairs(G.Enchants) do
                        if type(k) == "string" and k:lower() == lower then
                            id = k
                            break
                        end
                    end
                end
                if not dirOk or G.Enchants[id] ~= nil then
                    seen[id] = true
                    ids[#ids + 1] = id
                end
            end
        end
    end
    if #ids == 0 then return end
    local itemMod = loadModule("EnchantItem", { "Library", "Items", "EnchantItem" }, true)
    local masteryMod = loadModule("MasteryCmds", { "Library", "Client", "MasteryCmds" }, true)
    local maxSlots = tonumber(gval(G.EnchantCmds.GetMaxEquippedEnchants)) or 0
    for _, id in ipairs(ids) do
        if not state.alive then return end
        local okOwn, owned = gcall(G.EnchantCmds.Get, id)
        if okOwn and type(owned) == "table" and next(owned) ~= nil then
            local bestUid, bestTier = nil, -1
            for _, item in pairs(owned) do
                if type(item) == "table" and type(item.GetUID) == "function" and type(item.GetTier) == "function" then
                    local okU, uid = gcall(item.GetUID, item)
                    local okT, tier = gcall(item.GetTier, item)
                    if okU and type(uid) == "string" and okT and type(tier) == "number" and tier > bestTier then
                        bestUid, bestTier = uid, tier
                    end
                end
            end
            if bestUid ~= nil then
                local blocked = false
                if type(masteryMod) == "table" and type(masteryMod.CanUseEnchant) == "function" then
                    local okM, can = gcall(masteryMod.CanUseEnchant, bestTier)
                    if okM and can == false then blocked = true end
                end
                if blocked then
                    state.enchantStatus = "blocked:" .. id
                else
                    local cur = equippedSnapshot()
                    local hasUid = false
                    if type(cur) == "table" then
                        for _, uid in pairs(cur) do
                            if uid == bestUid then
                                hasUid = true
                                break
                            end
                        end
                    end
                    if not hasUid then
                        state.enchantStatus = "want:" .. id
                        local function equippedCount()
                            local n = 0
                            local c = equippedSnapshot()
                            if type(c) == "table" then
                                for _ in pairs(c) do
                                    n += 1
                                end
                            end
                            return n
                        end
                        local ecN = equippedCount()
                        state.enchantStatus = string.format("rep:%s:%d/%d:%s", id, ecN, maxSlots, tostring(type(itemMod) == "table" and type(itemMod.Get)))
                        if maxSlots > 0 and ecN >= maxSlots and type(itemMod) == "table" and type(itemMod.Get) == "function" then
                            local curNow = equippedSnapshot()
                            if type(curNow) == "table" then
                                local victim, fallback = nil, nil
                                for slot, uid in pairs(curNow) do
                                    local okIt, item = gcall(itemMod.Get, itemMod, uid)
                                    local sid, stier = nil, nil
                                    if okIt and type(item) == "table" then
                                        if type(item.GetId) == "function" then
                                            local okId, v = gcall(item.GetId, item)
                                            if okId and type(v) == "string" then sid = v end
                                        end
                                        if type(item.GetTier) == "function" then
                                            local okT, v = gcall(item.GetTier, item)
                                            if okT and type(v) == "number" then stier = v end
                                        end
                                    end
                                    if sid ~= nil then
                                        if not seen[sid] then
                                            victim = slot
                                            break
                                        elseif sid == id and stier ~= nil and stier < bestTier and fallback == nil then
                                            fallback = slot
                                        end
                                    end
                                end
                                local target = victim or fallback
                                if target ~= nil then
                                    gcall(G.EnchantCmds.Unequip, tonumber(target) or target)
                                    local t0 = os.clock()
                                    repeat
                                        task.wait(0.25)
                                        if not state.alive then return end
                                    until equippedCount() < maxSlots or os.clock() - t0 > 3
                                end
                            end
                        end
                        if maxSlots <= 0 or equippedCount() < maxSlots then
                            state.enchantStatus = "equip:" .. id
                            gcall(G.EnchantCmds.Equip, bestUid)
                            local t0 = os.clock()
                            local landed = false
                            repeat
                                task.wait(0.25)
                                if not state.alive then return end
                                local c = equippedSnapshot()
                                if type(c) == "table" then
                                    for _, uid in pairs(c) do
                                        if uid == bestUid then
                                            landed = true
                                            break
                                        end
                                    end
                                end
                            until landed or os.clock() - t0 > 3
                            if landed then
                                state.enchantStatus = "has:" .. id
                            else
                                state.enchantStatus = "stuck:" .. id
                            end
                        end
                    end
                end
            end
        end
    end
end

local function controllerTick()
    local info = rankInfo()
    if info then
        state.rank = info
        if state.lastRank ~= nil and info.rankNumber ~= state.lastRank then
            onRankUp(info)
        end
        state.lastRank = info.rankNumber
    end
    local goals, byType = activeGoals()
    state.goals = goals
    state.goalsByType = byType
    for _, goal in ipairs(goals) do
        if not goal.supported then
        end
    end
    if state.worldSwitching then
        buildPlan()
        checkWorld()
        return
    end
    pcall(claimRewards, info)
    pcall(checkTrackComplete, info)
    pcall(handleBlockedAndZones, info)
    pcall(checkWorld)
    do
        local zid = bestZoneId()
        if zid and zid ~= state.lastEggZoneId then
            local ok, done = pcall(unlockZoneEgg, zid)
            if ok and done then
                state.lastEggZoneId = zid
            end
        end
    end
    buildPlan()
end

