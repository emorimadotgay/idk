-- queue_on_teleport also fires when the account leaves PS99 for another game (seen live: it booted in
-- Anime Adventures, waited on PS99 modules and would have rejoined). Every PS99 place shares one universe.
do
    local PS99_UNIVERSE = 3317771874
    local t0 = os.clock()
    -- 0 means "not known yet" (slow joins, early autoexec), not "another game": only a known foreign id skips
    while game.GameId == 0 and os.clock() - t0 < 300 do task.wait(0.25) end
    if game.GameId ~= PS99_UNIVERSE then
        print(string.format("[Hayami] PS99 script skipped: not a Pet Simulator 99 place (universe %d)", game.GameId))
        return
    end
end

