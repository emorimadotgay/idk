            end
            local function gap(order, h)
                local f = Instance.new("Frame")
                f.LayoutOrder = order
                f.BackgroundTransparency = 1
                f.Size = UDim2.new(1, 0, 0, h)
                f.Parent = column
            end

            -- same order as buildRows: name, rank, timer, currencies, slots, progress, step, tasks
            GUI.labels[1] = line(1, 17, true)
            GUI.labels[2] = line(2, 11, false)
            gap(3, 6)
            GUI.labels[3] = line(4, 24, true)
            gap(5, 8)
            GUI.labels[4] = line(6, 12, false)
            GUI.labels[5] = line(7, 12, false)
            GUI.labels[6] = line(8, 12, false)
            GUI.labels[7] = line(9, 10, false)
            gap(10, 22)
            GUI.labels[8] = line(11, 11, false)
            gap(12, 14)

            -- footer: Hide GUI | RightCtrl toggle | version | Stop Script
            local footer = Instance.new("Frame")
            footer.LayoutOrder = 13
            footer.BackgroundTransparency = 1
            footer.Size = UDim2.new(0, 520, 0, 18)
            footer.Parent = column
            local function footerText(class, align, xScale, text, color)
                local t = Instance.new(class)
                t.BackgroundTransparency = 1
                t.AnchorPoint = Vector2.new(xScale, 0)
                t.Position = UDim2.fromScale(xScale, 0)
                t.Size = UDim2.new(0, class == "TextLabel" and 260 or 110, 1, 0)
                t.TextXAlignment = align
                t.TextSize = 10
                t.TextColor3 = color
