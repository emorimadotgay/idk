local function zoneNumberOf(zoneId)
    if not zoneId then return nil end
    local n = tonumber(tostring(zoneId):match("^(%d+)"))
    if n then return n end
    for _, top in ipairs(workspace:GetChildren()) do
        if (top:IsA("Folder") or top:IsA("Model")) and string.sub(top.Name, 1, 3) == "Map" then
            for _, f in ipairs(top:GetChildren()) do
                local num, name = tostring(f.Name):match("^(%d+)%s*|%s*(.+)$")
                if num and name == zoneId then return tonumber(num) end
            end
        end
    end
    return nil
end

local unlockedEggZones = {}
local function unlockZoneEgg(zoneId)
    if not zoneId or unlockedEggZones[zoneId] then return false end
    local n = zoneNumberOf(zoneId)
    if not n then return false end
    local owned = zoneNumberOf(bestZoneId())
    if owned == nil or n > owned then return false end
    if not isfn(G.EggCmds, "IsUnlocked") then return false end
    local eggId = eggIdForNumber(n)
    if not eggId then return false end
    local okU, isUn = gcall(G.EggCmds.IsUnlocked, eggId)
    if okU and isUn == true then
        unlockedEggZones[zoneId] = true
        return true
    end
    local things = workspace:FindFirstChild("__THINGS")
    local folder = things and things:FindFirstChild("ZoneEggs")
    local function findCapsule(node, depth)
        if depth > 3 then return nil end
        for _, ch in ipairs(node:GetChildren()) do
            if ch:IsA("Model") then
                local cn = tonumber(tostring(ch.Name):match("^(%d+)"))
                if cn == n then return ch end
            end
            if ch:IsA("Folder") or ch:IsA("Model") then
                local r = findCapsule(ch, depth + 1)
                if r then return r end
            end
        end
        return nil
    end
    local target = folder and findCapsule(folder, 0) or nil
    local part = target and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)) or nil
    state.hopping = true
    if part then
        pcall(function()
            local hrp = getHRP()
            if hrp then
                hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 6))
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        end)
        task.wait(0.5)
    end
    local ok, res = netInvoke("Eggs_RequestUnlock", eggId)
    task.wait(0.5)
    state.hopping = false
    local okV, isUn2 = gcall(G.EggCmds.IsUnlocked, eggId)
    if (ok and res ~= false) or (okV and isUn2 == true) then
        unlockedEggZones[zoneId] = true
        cache.eggAt = 0
        return true
    end
    return false
end

-- Teleports the character into the best zone's break zone when away. Rate limited (3 s).
local function ensureInBestZone()
    if state.hopping or state.worldSwitching or state.worldMismatch then return false end
    local now = os.clock()
    local force = state.returnAfterHatch ~= nil and now >= state.returnAfterHatch
    if not force and now - state.lastEnsureAt < 3 then return false end
    state.lastEnsureAt = now
    if inInstance() then
        return false
    end
    local zoneId = bestZoneId()
    if not zoneId then return false end
    local pos = standPosition(zoneId)
    if not pos then
        return false
    end
    local hrp = getHRP()
    if not hrp then return false end
    local cz = isfn(G.MapCmds, "GetCurrentZone") and gval(G.MapCmds.GetCurrentZone) or nil
    local dist = (hrp.Position - pos).Magnitude
    if dist > CONFIG.ZonePositionTolerance or (cz ~= nil and cz ~= zoneId) then
        pcall(function()
            hrp.CFrame = CFrame.new(pos)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
        state.returnAfterHatch = nil
        return true
    end
    state.returnAfterHatch = nil
    return false
end

