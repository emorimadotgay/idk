local function track(conn)
    -- Stop can land while main() is still installing: a late connection must not outlive it
    if stopped and conn then pcall(function() conn:Disconnect() end) return conn end
    if conn then connections[#connections + 1] = conn end
    return conn
end

local ready, delayKey
do
    local timers = {}
    ready = function(key, interval)
        local t = os.clock()
        if t >= (timers[key] or -1e9) then
            timers[key] = t + interval
            return true
        end
        return false
    end
    delayKey = function(key, seconds)
        timers[key] = os.clock() + seconds
    end
end

-- ring buffer, never printed (hundreds of clients must not spam output)
local log, readLog
do
local logBuf, logPos = {}, 0
log = function(fmt, ...)
    local ok, msg = pcall(string.format, fmt, ...)
    logPos = logPos % 60 + 1
    logBuf[logPos] = string.format("%7.1f  %s", os.clock() - state.bootClock, ok and msg or tostring(fmt))
end
readLog = function()
    local out = {}
    for i = 1, 60 do
        local line = logBuf[(logPos + i - 1) % 60 + 1]
        if line then out[#out + 1] = line end
    end
    return table.concat(out, "\n")
end
end
-- Errors go to the log AND, once per distinct message, to the console (F9) and the STEP line.
-- Before this every failure was swallowed, so a broken boot looked like "nothing happens".
local report
do
local reported, reportedCount = {}, 0
report = function(where, err)
    local msg = string.format("%s: %s", tostring(where), tostring(err))
    log("%s", msg)
    state.lastError, state.lastErrorAt = msg, os.clock()
    if not reported[msg] and reportedCount < 25 then
        reported[msg] = true
        reportedCount += 1
        warn("[Hayami] " .. msg)
    end
end
end

