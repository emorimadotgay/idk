local eggCache = {} -- egg number -> info (bounded by the number of zone eggs)
local function eggInfo(n)
    if type(n) ~= "number" then return nil end
    if eggCache[n] then return eggCache[n] end
    local dir = isfn(G.EggsUtil, "GetByNumber") and gv(G.EggsUtil.GetByNumber, n) or nil
    if type(dir) ~= "table" then return nil end
    local petIds = {}
    if type(dir.pets) == "table" then
        for _, e in pairs(dir.pets) do
            local pid = type(e) == "table" and e[1] or e
            if type(pid) == "string" then petIds[pid] = true end
        end
    end
    local info = { n = n, id = dir._id, dir = dir, petIds = petIds, name = dir.name or dir._id }
    eggCache[n] = info
    return info
end

local function bestEggNumber()
    local save = getSave()
    return save and tonumber(save.MaximumAvailableEgg) or nil
end

-- highest unlocked egg that exists in the world (an egg without a position can never be hatched)
local function bestEgg()
    local top = bestEggNumber()
    if not top then return nil end
    for n = top, math.max(1, top - 10), -1 do
        if eggPosition(n) then return eggInfo(n) end
    end
    return eggInfo(top)
end

local petEggIndex = nil
local function eggForPet(petId)
    if type(petId) ~= "string" or type(G.Eggs) ~= "table" then return nil end
    if not petEggIndex then
        petEggIndex = {}
        for id, e in pairs(G.Eggs) do
            local n = type(e) == "table" and tonumber(e.eggNumber) or nil
            if n and type(e.pets) == "table" then
                for _, p in pairs(e.pets) do
                    local pid = type(p) == "table" and p[1] or p
                    if type(pid) == "string" then
                        local list = petEggIndex[pid] or {}
                        list[#list + 1] = { id = id, n = n }
                        petEggIndex[pid] = list
                    end
                end
            end
        end
    end
    local maxN = bestEggNumber() or 0
    local pick = nil
    for _, e in ipairs(petEggIndex[petId] or {}) do
        if e.n <= maxN and (pick == nil or e.n > pick.n) then pick = e end
    end
    return pick and eggInfo(pick.n) or nil
end

local function eggForId(eggId)
    local dir = dget(G.Eggs, eggId)
    local n = dir and tonumber(dir.eggNumber) or nil
    if not n then return nil end
    if (bestEggNumber() or 0) < n then return nil end
    return eggInfo(n)
end

local maxHatchCache = { v = 1, at = -1e9 }
local function maxHatch()
    if os.clock() - maxHatchCache.at < 20 then return maxHatchCache.v end
    maxHatchCache.at = os.clock()
    local n = isfn(G.EggCmds, "GetMaxHatch") and gv(G.EggCmds.GetMaxHatch) or nil
    if type(n) == "number" and n >= 1 then maxHatchCache.v = math.floor(n) end
    return maxHatchCache.v
end

