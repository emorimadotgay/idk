    }
end

-- Fresh remaining amount (0 when the goal was replaced or finished).
local function liveRemaining(goal)
    local save = getSave()
    if not save then return goal.remaining end
    local g
    if goal.source == "gate" then
        g = save.ZoneGateQuest
        if type(g) ~= "table" or g.Type ~= goal.Type then return 0 end
    else
        g = nil
        if type(save.Goals) == "table" then
            for _, x in pairs(save.Goals) do
                if type(x) == "table" and x.UID == goal.UID then g = x break end
            end
        end
        if not g then return 0 end
    end
    return math.max(0, (tonumber(g.Amount) or 0) - (tonumber(g.Progress) or 0))
end

local function goalParam(goal, field)
    local v = goal.raw[field]
    if v ~= nil or goal.source ~= "rank" then return v end
    local pools = state.rank and state.rank.dir and state.rank.dir.Goals
    local pool = type(pools) == "table" and (pools[goal.tier] or pools[tonumber(goal.tier)]) or nil
    if type(pool) ~= "table" then return nil end
    local fallback = nil
    for _, e in pairs(pool) do
        if type(e) == "table" and e.Type == goal.Type and e[field] ~= nil then
            if e.Amount == goal.Amount then return e[field] end
            fallback = fallback or e[field]
        end
    end
    return fallback
end

local function readGoals(save)
    local list = {}
    state.gate = nil
    -- zone gate quest blocks the next zone purchase, so it always comes first
    local gq = save.ZoneGateQuest
    local nextDir = state.nextZoneDir
    if type(gq) == "table" and gq.Type ~= nil and nextDir and type(nextDir.QuestsRequired) == "table"
        and save.ZoneGateQuestID == state.nextZoneId
        and (tonumber(save.ZoneGateQuestIndex) or 1) <= #nextDir.QuestsRequired then
        local g = makeGoal(gq, "gate", "gate")
        if g.remaining > 0 then
            state.gate = g
            list[#list + 1] = g
        end
    end
    local rankGoals = {}
    if not (state.rank and state.rank.isMax) and type(save.Goals) == "table" then
        for tier, raw in pairs(save.Goals) do
            if type(raw) == "table" and raw.Type ~= nil then
                rankGoals[#rankGoals + 1] = makeGoal(raw, "rank", tier)
            end
        end
    end
    table.sort(rankGoals, function(a, b)
        if a.Stars ~= b.Stars then return a.Stars > b.Stars end
        return tostring(a.tier) < tostring(b.tier)
    end)
    for _, g in ipairs(rankGoals) do list[#list + 1] = g end
    state.goals = list
end

-- =====================================================================================
--  8. Rank
-- =====================================================================================
local function readRank(save)
    local info = { number = tonumber(save.Rank) or 1, stars = tonumber(save.RankStars) or 0, rebirths = tonumber(save.Rebirths) or 0 }
    info.id = isfn(G.RanksUtil, "RankIDFromNumber") and gv(G.RanksUtil.RankIDFromNumber, info.number) or nil
    info.dir = dget(G.Ranks, info.id)
    info.title = (info.dir and info.dir.Title) or ("Rank " .. info.number)
    info.rewards = (info.dir and type(info.dir.Rewards) == "table") and info.dir.Rewards or {}
    local total = 0
    for _, rw in ipairs(info.rewards) do total += tonumber(type(rw) == "table" and rw.StarsRequired) or 0 end
    info.totalStars = total
    info.redeemed = type(save.RedeemedRankRewards) == "table" and save.RedeemedRankRewards or {}
    local cnt = 0
    for _, v in pairs(info.redeemed) do if v then cnt += 1 end end
    info.redeemedCount = cnt
    info.isMax = isfn(G.RankCmds, "IsMaxRank") and gv(G.RankCmds.IsMaxRank) == true
    if isfn(G.RankCmds, "IsRankBlockedByZone") then
        local bz, br, zn, rn = gv(G.RankCmds.IsRankBlockedByZone)
        info.blockedByZone, info.blockedByRebirth, info.zoneNeeded, info.rebirthsNeeded = bz == true, br == true, zn, rn
    end
    return info
end

-- Rank quests first: true while ranks remain and RankFocus is on.
local function rankFocused()
    local r = state.rank
    return CONFIG.RankFocus and r ~= nil and not r.isMax
end

local function claimRanks(info)
    if not CONFIG.AutoClaimRanks or not info then return end
    if state.lastRedeemed ~= nil and info.redeemedCount > state.lastRedeemed then
        state.counters.claimed += info.redeemedCount - state.lastRedeemed
        state.claimAllTries = 0
        state.lastProgressAt = os.clock()
    end
    state.lastRedeemed = info.redeemedCount
    local unclaimed, cum = {}, 0
    for i, rw in ipairs(info.rewards) do
        cum += tonumber(type(rw) == "table" and rw.StarsRequired) or 0
        if cum <= info.stars and not info.redeemed[tostring(i)] then unclaimed[#unclaimed + 1] = i end
    end
    if #unclaimed == 0 or not ready("claimRanks", 6) then return end
    if state.claimAllTries < 3 then
        state.claimAllTries += 1
        netFire("Ranks_ClaimAll")
    else
        -- ClaimAll did nothing (flag off?): claim one by one, never give up (the rank needs every reward)
        for _, i in ipairs(unclaimed) do netFire("Ranks_ClaimReward", i) end
        delayKey("claimRanks", 20)
    end
end

-- =====================================================================================
--  9. Farm: breakable registry (event driven), pet assignment, taps
-- =====================================================================================
local registryDirty = true   -- also set by the brain on a zone change
local petAt = -1e9           -- also reset by the equip step to force a pet refresh
local farmStep, tapStep, installFastCollect, installBreakableRegistry
do
local EVENT_WORDS = { "comet", "pinata", "jar", "lucky", "chest" }
local registry = {}         -- model -> { uid, zone, prio }
local targets = { zone = nil, p1 = {}, p2 = {}, p3 = {} }
local assign = {}           -- pet euid -> breakable uid
local lastBulkSig, lastBulkAt, lastTier = "", 0, 3
local tapList, nextTapAt, focusUid = {}, 0, nil
local uidPos = {}           -- breakable uid -> position (breakables do not move)
local petList, petSig = {}, ""

-- 1 = event / chest, 2 = diamond, 3 = rest
local function classify(m)
    local class = m:GetAttribute("BreakableClass")
    if class ~= nil and class ~= "Normal" then return 1 end
    local id = string.lower(tostring(m:GetAttribute("BreakableID") or ""))
    for _, w in ipairs(EVENT_WORDS) do
        if string.find(id, w, 1, true) then return 1 end
    end
    if string.find(id, "diamond", 1, true) then return 2 end
    return 3
end

local function forcePetSpeed()
    if not (CONFIG.InfinitePetSpeed and isfn(G.PlayerPet, "GetByPlayer")) then return end
    local ok, pets = gcall(G.PlayerPet.GetByPlayer, LocalPlayer)
    if not ok or type(pets) ~= "table" then return end
    for _, pet in pairs(pets) do
        if type(pet) == "table" then
            pcall(function()
                pet.speedMult = math.huge
                if pet.cpet ~= nil then pet.cpet:Broadcast("petSpeedMult", math.huge) end
            end)
        end
    end
end

local function localPets()
    if os.clock() - petAt < 2 then return petList end
    petAt = os.clock()
    table.clear(petList)
    if isfn(G.PlayerPet, "GetByPlayer") then
        local ok, pets = gcall(G.PlayerPet.GetByPlayer, LocalPlayer)
        if ok and type(pets) == "table" then
            for _, p in pairs(pets) do
                if type(p) == "table" and p.euid ~= nil then petList[#petList + 1] = p.euid end
            end
        end
    end
    local sig = #petList > 0 and (tostring(petList[1]) .. ":" .. #petList) or ""
    if sig ~= petSig then
        petSig = sig
        forcePetSpeed() -- only when the team changes, not every second
    end
    return petList
end

local function rebuildTargets(zoneId)
    table.clear(targets.p1) table.clear(targets.p2) table.clear(targets.p3)
    targets.zone = zoneId
    for _, e in pairs(registry) do
        if e.zone == zoneId then
            local bucket = e.prio == 1 and targets.p1 or (e.prio == 2 and targets.p2 or targets.p3)
            bucket[#bucket + 1] = e.uid
        end
    end
    -- nearest first: pets and taps work the closest breakables, no cross-zone flights
    local origin = state.standPos or (getHRP() and getHRP().Position)
    if origin then
        local dist = {}
        for _, bucket in ipairs({ targets.p1, targets.p2, targets.p3 }) do
            for _, u in ipairs(bucket) do
                local p = uidPos[u]
                dist[u] = p and (p - origin).Magnitude or 1e9
            end
            table.sort(bucket, function(a, b) return dist[a] < dist[b] end)
        end
    end
    registryDirty = false
end

local function sendAssignments(pets, list, tier, force)
    if tier < lastTier then table.clear(assign) end
    lastTier = tier
    local live, used = {}, {}
    for _, u in ipairs(list) do live[u] = true end
    local petSet = {}
    for _, e in ipairs(pets) do petSet[e] = true end
    for e, u in pairs(assign) do
        if live[u] and petSet[e] then used[u] = true else assign[e] = nil end
    end
    local free = {}
    for _, u in ipairs(list) do if not used[u] then free[#free + 1] = u end end
    local rr, fi = 0, 1
    local map, parts = {}, {}
    for _, e in ipairs(pets) do
        if assign[e] == nil then
            if fi <= #free then
                assign[e] = free[fi]
                fi += 1
            else
                rr += 1
                assign[e] = list[(rr - 1) % #list + 1]
            end
        end
        map[e] = assign[e]
        parts[#parts + 1] = tostring(e) .. "=" .. tostring(assign[e])
    end
    -- taps go where most pets already are: that breakable dies first
    local counts, bestN = {}, 0
    focusUid = nil
    for _, u in pairs(assign) do
        local n = (counts[u] or 0) + 1
        counts[u] = n
        if n > bestN then bestN, focusUid = n, u end
    end
    local sig = table.concat(parts, "|")
    local t = os.clock()
    if force or sig ~= lastBulkSig or t - lastBulkAt > 4 then
        lastBulkSig, lastBulkAt = sig, t
        netFire("Breakables_JoinPetBulk", map)
    end
end

local mixedList = {}
-- Non-yielding: picks targets and sends assignments. Also run straight after a breakable dies.
local function assignStep()
    local zoneId = state.farmZone
    if not zoneId or #petList == 0 then return end
    if registryDirty or targets.zone ~= zoneId then rebuildTargets(zoneId) end
    local list, tier
    if #targets.p1 > 0 then
        list, tier = targets.p1, 1
    elseif #targets.p2 > 0 and state.plan.diamonds then
        list, tier = targets.p2, 2
    else
        table.clear(mixedList)
        for _, u in ipairs(targets.p2) do mixedList[#mixedList + 1] = u end
        for _, u in ipairs(targets.p3) do mixedList[#mixedList + 1] = u end
        list, tier = mixedList, 3
    end
    state.farmTargets = #list
    tapList = list
    if #list == 0 then return end
    sendAssignments(petList, list, tier, false)
end

local reassignQueued = false
local function queueReassign()
    if reassignQueued then return end
    reassignQueued = true
    task.defer(function()
        reassignQueued = false
        if state.alive and state.ready and CONFIG.AutoFarm and not state.worldSwitching then pcall(assignStep) end
    end)
end

farmStep = function()
    if not CONFIG.AutoFarm or not state.ready or state.worldSwitching then return end
    if inInstance() then state.farmTargets = 0 return end
    ensureInZone()
    if not state.farmZone then return end
    local pets = localPets()
    state.petCount = #pets
    if #pets == 0 then
        if CONFIG.AutoEquipBest and ready("equipEmpty", 30) and isfn(G.PetCmds, "EquipBest") then gcall(G.PetCmds.EquipBest) end
        return
    end
    assignStep()
end

tapStep = function()
    local t = os.clock()
    if t < nextTapAt or #tapList == 0 or state.worldSwitching then return end
    nextTapAt = t + CONFIG.TapDelay
    local hrp = getHRP()
    local function inRange(uid)
        local p = uid ~= nil and uidPos[uid] or nil
        return p ~= nil and (not hrp or (hrp.Position - p).Magnitude <= 200) -- game max hit distance is 220
    end
    local uid = focusUid
    if not inRange(uid) then uid = tapList[1] end -- nearest
    if not inRange(uid) then return end
    netUnreliable("Breakables_PlayerDealDamage", uid)
end

-- Event / chest breakable spawned in our zone: every pet on it right away.
local function fastPath(entry)
    if entry.prio ~= 1 or entry.zone ~= state.farmZone or not CONFIG.AutoFarm or state.worldSwitching then return end
    local pets = petList
    if #pets == 0 then return end
    table.clear(assign)
    local map = {}
    for _, e in ipairs(pets) do
        map[e] = entry.uid
        assign[e] = entry.uid
    end
    lastTier = 1
    netUnreliable("Breakables_PlayerDealDamage", entry.uid)
    netFire("Breakables_JoinPetBulk", map)
    state.counters.events += 1
end

local function registryAdd(m)
    if registry[m] or typeof(m) ~= "Instance" or not m:IsA("Model") then return nil end
    local uid, zone = m:GetAttribute("BreakableUID"), m:GetAttribute("ParentID")
    if uid == nil or zone == nil then return nil end
    if m:GetAttribute("AreaID") == "VIP" and not ownsVip() then return nil end -- VIP-room piles: no damage without the pass
    local entry = { uid = uid, zone = zone, prio = classify(m) }
    local ok, pivot = pcall(m.GetPivot, m)
    if ok and typeof(pivot) == "CFrame" then uidPos[uid] = pivot.Position end
    registry[m] = entry
    registryDirty = true
    return entry
end

local function onBreakableAdded(m)
    if not state.alive then return end
    local entry = registryAdd(m)
    if entry then
        pcall(fastPath, entry)
        return
    end
    -- attributes can replicate a moment after the instance
    task.delay(0.15, function()
        if not state.alive or m.Parent == nil then return end
        local e = registryAdd(m)
        if e then pcall(fastPath, e) end
    end)
end

local function onBreakableRemoved(m)
    local e = registry[m]
    if e then
        registry[m] = nil
        uidPos[e.uid] = nil
        registryDirty = true
        if e.zone == state.farmZone then queueReassign() end -- pets move on now, not next tick
    end
end

-- Orbs and lootbags: the game simulates every drop flying to you before it reports the pickup.
-- The ids arrive with "Orbs: Create"; one batched "Orbs: Collect" after the pickup delay does the same job.
-- The magnet path stays as the fallback.
installFastCollect = function()
    if not CONFIG.FastCollect or not isfn(G.Network, "Fired") then return end
    local ok, signal = gcall(G.Network.Fired, "Orbs: Create")
    if not ok or signal == nil then return end
    local pending, flushing = {}, false
    local function flush()
        task.wait(1.2)
        flushing = false
        if not state.alive or #pending == 0 then return end
        local ids = pending
        pending = {}
        netFire("Orbs: Collect", ids)
    end
    local okC, conn = pcall(function()
        return signal:Connect(function(list)
            if not state.alive or type(list) ~= "table" then return end
            for _, o in ipairs(list) do
                if type(o) == "table" and o.id ~= nil then pending[#pending + 1] = o.id end
            end
            if not flushing and #pending > 0 then
                flushing = true
                task.spawn(flush)
            end
        end)
    end)
    if okC then track(conn) end
end

installBreakableRegistry = function()
    task.spawn(function()
        local things = workspace:WaitForChild("__THINGS", 120)
        local folder = things and things:WaitForChild("Breakables", 120)
        if not folder or not state.alive then return end
        for _, m in ipairs(folder:GetChildren()) do registryAdd(m) end
        track(folder.ChildAdded:Connect(onBreakableAdded))
        track(folder.ChildRemoved:Connect(onBreakableRemoved))
    end)
end
end

-- =====================================================================================
-- 10. Crafting & items (goal handlers)
-- =====================================================================================
local handleGold, handleRainbow, handleUsePotion, handleUpgrade, handleUseFruit, handleUseFlag, stepEvents, stacks
do
    local function inventory(category)
        local save = getSave()
        local inv = save and save.Inventory
        local cat = type(inv) == "table" and inv[category] or nil
        return type(cat) == "table" and cat or {}
    end

    stacks = function(category, predicate)
        local out = {}
        for uid, item in pairs(inventory(category)) do
            if type(item) == "table" then
                local amount = tonumber(item._am) or 1
                if amount >= 1 and (predicate == nil or predicate(item, amount)) then
                    out[#out + 1] = { uid = uid, item = item, amount = amount }
                end
            end
        end
        table.sort(out, function(a, b) return a.amount > b.amount end)
        return out
    end

    local function pickByPriority(list, priority)
        for _, id in ipairs(priority or {}) do
            for _, s in ipairs(list) do
                if s.item.id == id then return s end
            end
        end
        return nil
    end

    local function orderByPriority(list, priority)
        local rank = {}
        for i, id in ipairs(priority or {}) do rank[id] = i end
        table.sort(list, function(a, b)
            local ra, rb = rank[a.item.id] or 1e9, rank[b.item.id] or 1e9
            if ra ~= rb then return ra < rb end
            return a.amount > b.amount
        end)
        return list
    end

    local function perkReduction(perk)
        if not (isfn(G.MasteryCmds, "HasPerk") and isfn(G.MasteryCmds, "GetPerkPower")) then return 0 end
        if gv(G.MasteryCmds.HasPerk, "Pets", perk) ~= true then return 0 end
        return tonumber(gv(G.MasteryCmds.GetPerkPower, "Pets", perk)) or 0
    end

    local function fodderStacks(ptWanted, allowedIds)
        local protected = {}
        for _, id in ipairs(CONFIG.ProtectedPetIds or {}) do protected[id] = true end
        return stacks("Pet", function(item)
            if type(item.id) ~= "string" or protected[item.id] then return false end
            if (tonumber(item.pt) or 0) ~= ptWanted then return false end
            if allowedIds and not allowedIds[item.id] then return false end
            if item.sh == true and not CONFIG.UseShinyPetsAsFodder then return false end
            return true
        end)
    end

    -- allowed pet ids for a craft goal (nil = any) and the egg that supplies fodder
    local function craftSource(goal)
        local petId = goalParam(goal, "PetID")
        if type(petId) == "string" then
            return { [petId] = true }, eggForPet(petId), petId
        end
        if BEST_EGG_CRAFT[goal.name] then
            local egg = bestEgg()
            if not (egg and next(egg.petIds)) then return false end
            return egg.petIds, egg, nil
        end
        return nil, bestEgg(), nil
    end

    -- crafts up to rem outputs: cost inputs of one stack -> 1 output. Returns crafted, rem, largest stack (nil on remote failure)
    local function craftFrom(remote, list, rem, cost, liveCap)
        local crafted = 0
        for _, s in ipairs(list) do
            if rem <= 0 then break end
            while rem > 0 and s.amount >= cost and state.alive do
                local k = math.min(math.floor(s.amount / cost), rem, 50)
                local ok, res = netInvoke(remote, s.uid, k) -- amount = OUTPUT pets
                if not (ok and res) then return crafted, rem, nil end
                crafted += k
                rem -= k
                s.amount -= k * cost
                state.counters.crafted += k
                state.lastProgressAt = os.clock()
                task.wait(0.4)
                if liveCap then rem = math.min(rem, liveCap()) end
            end
        end
        local best = 0
        for _, s in ipairs(list) do best = math.max(best, s.amount) end
        return crafted, rem, best
    end

    local function anyStack(list, cost)
        for _, s in ipairs(list) do
            if s.amount >= cost then return true end
        end
        return false
    end

    local function largest(list)
        local best = 0
        for _, s in ipairs(list) do best = math.max(best, s.amount) end
        return best
    end

    local function goldCap()
        local cap = nil
        for _, g in ipairs(state.goals) do
            if GOLD_GOALS[g.name] then
                local r = liveRemaining(g)
                cap = cap and math.min(cap, r) or r
            end
        end
        return cap
    end

    local function fodderNeed(left, leftover, cost, egg, petId)
        if petId and not egg then return nil end -- that pet does not come from an egg we can open
        if left > 0 and leftover ~= nil then
            return { need = math.max(1, left * cost - leftover), egg = egg, petId = petId }
        end
        return nil
    end

    handleGold = function(goal)
        local allowed, egg, petId = craftSource(goal)
        if allowed == false then return nil end
        local rem = liveRemaining(goal)
        if rem <= 0 then return nil end
        local cost = math.max(1, 10 - perkReduction("GoldReduction"))
        local normal = fodderStacks(0, allowed)
        if not anyStack(normal, cost) then return fodderNeed(rem, largest(normal), cost, egg, petId) end -- no trip to the machine
        setDoing("Gold machine")
        local _, left, leftover = withMachine("GoldMachine", craftFrom, "GoldMachine_Activate", normal, rem, cost,
            function() return liveRemaining(goal) end)
        return fodderNeed(left or 0, leftover, cost, egg, petId)
    end

    handleRainbow = function(goal)
        local allowed, egg, petId = craftSource(goal)
        if allowed == false then return nil end
        local rem = liveRemaining(goal)
        if rem <= 0 then return nil end
        local rCost = math.max(1, 10 - perkReduction("RainbowReduction"))
        local gCost = math.max(1, 10 - perkReduction("GoldReduction"))
        local golden = fodderStacks(1, allowed)
        local left, leftover = rem, largest(golden)
        if anyStack(golden, rCost) then
            setDoing("Rainbow machine")
            local _
            _, left, leftover = withMachine("RainbowMachine", craftFrom, "RainbowMachine_Activate", golden, rem, rCost,
                function() return liveRemaining(goal) end)
        end
        if leftover == nil or (left or 0) <= 0 then return nil end
        -- golden of ONE id are needed: concentrate on the id that already has the most golden
        local goldenById = {}
        for _, s in ipairs(golden) do goldenById[s.item.id] = (goldenById[s.item.id] or 0) + s.amount end
        local normal = fodderStacks(0, allowed)
        table.sort(normal, function(a, b)
            local ga, gb = goldenById[a.item.id] or 0, goldenById[b.item.id] or 0
            if ga ~= gb then return ga > gb end
            return a.amount > b.amount
        end)
        local src = normal[1]
        if not src then return fodderNeed(left, 0, rCost * gCost, egg, petId) end
        local goldenNeeded = left * rCost - (goldenById[src.item.id] or 0)
        if goldenNeeded <= 0 then return nil end
        if not anyStack({ src }, gCost) then return fodderNeed(goldenNeeded, src.amount, gCost, egg, petId) end
        local cap = goldCap() -- a gold goal also counts these crafts: never overshoot it
        if cap ~= nil then
            if cap <= 0 then return nil end
            goldenNeeded = math.min(goldenNeeded, cap)
        end
        local made, gLeft, gLeftover = withMachine("GoldMachine", craftFrom, "GoldMachine_Activate", { src }, goldenNeeded, gCost,
            cap ~= nil and goldCap or nil)
        if (made or 0) > 0 then
            task.wait(0.6)
            local r = liveRemaining(goal)
            if r > 0 then withMachine("RainbowMachine", craftFrom, "RainbowMachine_Activate", fodderStacks(1, allowed), r, rCost) end
        end
        return fodderNeed(gLeft or 0, gLeftover, gCost, egg, petId)
    end

    local POTION_REQ_FALLBACK = { 3, 3, 4, 5, 5, 5, 5, 5, 7, 7, 7 }
    local ENCHANT_REQ_FALLBACK = { 3, 3, 3, 5, 5, 5, 5, 5, 8, 8 }
    local function tierRequirement(isPotion, srcTier)
        local b = G.Balancing
        local fn = type(b) == "table" and (isPotion and b.CalcPotionsPerTierRequired or b.CalcEnchantsPerTierRequired) or nil
        if type(fn) == "function" then
            local n = gv(fn, srcTier)
            if type(n) == "number" and n >= 1 then return math.floor(n) end
        end
        local fb = isPotion and POTION_REQ_FALLBACK or ENCHANT_REQ_FALLBACK
        return fb[srcTier] or fb[#fb]
    end

    handleUsePotion = function(goal)
        local T = tonumber(goalParam(goal, "PotionTier"))
        local wantId = goalParam(goal, "PotionID")
        local rem = liveRemaining(goal)
        if rem <= 0 then return end
        for _ = 1, math.min(rem, 10) do
            if not state.alive then return end
            local list = stacks("Potion", function(item)
                if T and tonumber(item.tn) ~= T then return false end
                if type(wantId) == "string" and item.id ~= wantId then return false end
                return true
            end)
            local s = pickByPriority(list, CONFIG.PotionUsePriority) or list[1]
            if not s or not netFire("Potions: Consume", s.uid, 1) then return end
            state.counters.items += 1
            setDoing("Using potions")
            task.wait(0.4)
        end
    end

    handleUpgrade = function(goal, isPotion)
        local T = tonumber(goalParam(goal, isPotion and "PotionTier" or "EnchantTier"))
        if not T or T < 2 or (isPotion and T > CONFIG.MaxInventoryPotionTier) then return end
        local wantId = goalParam(goal, isPotion and "PotionID" or "EnchantID")
        local rem = liveRemaining(goal)
        if rem <= 0 then return end
        local need = tierRequirement(isPotion, T - 1)
        local dirTable = isPotion and G.Potions or G.Enchants
        local list = stacks(isPotion and "Potion" or "Enchant", function(item)
            if tonumber(item.tn) ~= T - 1 then return false end
            if type(wantId) == "string" and item.id ~= wantId then return false end
            local d = dget(dirTable, item.id)
            local maxTier = d and tonumber(d.MaxTier) or nil
            return not (maxTier and maxTier < T)
        end)
        orderByPriority(list, isPotion and CONFIG.PotionUpgradePriority or CONFIG.EnchantUpgradePriority)
        local remote = isPotion and "UpgradePotionsMachine_Activate" or "UpgradeEnchantsMachine_Activate"
        local machine = isPotion and "UpgradePotionsMachine" or "UpgradeEnchantsMachine"
        if not list[1] or list[1].amount < need then
            local any = false
            for _, s in ipairs(list) do if s.amount >= need then any = true break end end
            if not any then return end
        end
        setDoing(isPotion and "Upgrading potions" or "Upgrading enchants")
        withMachine(machine, function()
            for _, s in ipairs(list) do
                if rem <= 0 or not state.alive then break end
                if s.amount >= need then
                    local k = math.min(math.floor(s.amount / need), rem, 25)
                    local ok, res = netInvoke(remote, s.uid, k)
                    if not (ok and res) then break end
                    rem = math.min(rem - k, liveRemaining(goal))
                    state.counters.crafted += k
                    task.wait(0.5)
                end
            end
        end)
    end

    handleUseFruit = function(goal)
        local wantId = goalParam(goal, "FruitID")
        local rem = liveRemaining(goal)
        if rem <= 0 then return end
        for _ = 1, math.min(rem, 10) do
            if not state.alive then return end
            local list = stacks("Fruit", function(item)
                if item.sh == true and not CONFIG.AllowShinyFruit then return false end
                if type(wantId) == "string" and item.id ~= wantId then return false end
                return true
            end)
            local s = pickByPriority(list, CONFIG.FruitUsePriority) or list[1]
            if not s or not netFire("Fruits: Consume", s.uid, 1) then return end
            state.counters.items += 1
            setDoing("Eating fruit")
            task.wait(0.4)
        end
    end

    handleUseFlag = function(goal)
        if not ready("flag", 5) or not isfn(G.FlexibleFlagCmds, "Consume") or inInstance() then return end
        if liveRemaining(goal) <= 0 then return end
        local zoneId = state.farmZone
        local cz = isfn(G.MapCmds, "GetCurrentZone") and gv(G.MapCmds.GetCurrentZone) or nil
        local inBox = isfn(G.MapCmds, "IsInDottedBox") and gv(G.MapCmds.IsInDottedBox) or nil
        if cz ~= zoneId or inBox ~= true then
            state.forceEnsure = true
            return
        end
        local list = stacks("Misc", function(item) return type(item.id) == "string" and string.sub(item.id, -5) == " Flag" end)
        local s = pickByPriority(list, CONFIG.FlagPriority) or list[1]
        if not s then delayKey("flag", 60) return end
        local ok, res, msg = gcall(G.FlexibleFlagCmds.Consume, s.item.id, s.uid, 1)
        if ok and res == true then
            state.counters.items += 1
            setDoing("Placing flag")
        else
            local m = string.lower(tostring(msg or ""))
            delayKey("flag", (string.find(m, "different flag", 1, true) or string.find(m, "already", 1, true)) and 60 or 20)
        end
    end

    -- =====================================================================================
    -- 11. Event items (comets / pinatas / lucky blocks / coin jars)
    -- =====================================================================================
    local EVENT_DEFS = {
        Comet = { items = { "Comet" }, remote = "Comet_Spawn", match = "comet" },
        Pinata = { items = { "Mini Pinata" }, remote = "MiniPinata_Consume", match = "pinata" },
        LuckyBlock = { items = { "Mini Lucky Block" }, remote = "MiniLuckyBlock_Consume", match = "luckyblock" },
        CoinJar = { items = CONFIG.CoinJarPriority, remote = "CoinJar_Spawn", match = "coinjar" },
    }

    local function activeEventKinds(zoneId)
        local kinds = {}
        if not isfn(G.RandomEventCmds, "GetActive") then return kinds end
        local ok, active = gcall(G.RandomEventCmds.GetActive)
        if not ok or type(active) ~= "table" then return kinds end
        for _, ev in pairs(active) do
            if type(ev) == "table" and (ev.parentID == nil or ev.parentID == zoneId) then
                local names = { ev.id, ev.name, type(ev.dir) == "table" and ev.dir._id or nil, type(ev.dir) == "table" and ev.dir.Name or nil }
                for _, n in pairs(names) do
                    if type(n) == "string" then
                        local norm = string.lower((string.gsub(n, "%s", "")))
                        for kind, def in pairs(EVENT_DEFS) do
                            if string.find(norm, def.match, 1, true) then kinds[kind] = true end
                        end
                    end
                end
            end
        end
        return kinds
    end

    stepEvents = function()
        if not CONFIG.AutoEvents or not ready("events", 3) or inInstance() then return end
        local wanted = {}
        for _, g in ipairs(state.goals) do
            local kind = EVENT_KIND[g.name]
            if kind and g.remaining > 0 and not wanted[kind] then wanted[kind] = g end
        end
        if next(wanted) == nil then return end
        local zoneId = state.farmZone
        local cz = isfn(G.MapCmds, "GetCurrentZone") and gv(G.MapCmds.GetCurrentZone) or nil
        if cz ~= zoneId then state.forceEnsure = true return end
        local active = activeEventKinds(zoneId)
        for kind, goal in pairs(wanted) do
            local def = EVENT_DEFS[kind]
            if not active[kind] and ready("event:" .. kind, 12) and liveRemaining(goal) > 0 then
                local set_ = {}
                for _, id in ipairs(def.items) do set_[id] = true end
                local list = stacks("Misc", function(item) return set_[item.id] == true end)
                local s = pickByPriority(list, def.items) or list[1]
                if s then
                    local ok, res = netInvoke(def.remote, s.uid)
                    if ok and res == true then
                        state.counters.items += 1
                        setDoing("Spawning " .. kind)
                    else
                        delayKey("event:" .. kind, 20)
                    end
                    task.wait(0.3)
                end
            end
        end
    end

end

-- =====================================================================================
-- 12. Worker steps (one thread, sequential: no two actions ever move the character at once)
-- =====================================================================================
local workTick
do
    local function worldTeleport(n)
        if state.worldSwitching or not ready("worldTp", 30) then return false end
        if os.time() - (state.lastWorldSwitch or 0) < 90 then return false end -- anti-loop across places
        if not queueSelf() then
            state.worldBlocked = n
            log("world %d ready but nothing to re-execute (set ScriptUrl / WorkspaceFile / AutoexecInstalled)", n)
            return false
        end
        state.worldBlocked = nil
        local previous = state.lastWorldSwitch
        state.lastWorldSwitch = os.time()
        persist()
        state.worldSwitching = true
        state.worldSwitchAt = os.clock()
        setDoing("Teleporting to World " .. n)
        log("world teleport -> %d", n)
        local ok, res = netInvoke(string.format("World%dTeleport", n))
        if not ok or res == false then
            state.worldSwitching = false
            state.lastWorldSwitch = previous
            persist()
            log("world teleport %d failed: %s", n, tostring(res))
            return false
        end
        return true
    end

    -- Rank focus: zones, rebirths and new worlds only when the rank or a quest needs them. Breakable / hatch
    -- quests count items, not coins, and a deeper zone only makes breakables tougher and eggs dearer.
    local function rankNeedsZones()
        local r = state.rank
        if r and (r.blockedByZone or r.blockedByRebirth) then return true end
        if state.gate then return true end
        for _, g in ipairs(state.goals) do
            if ZONE_GOALS[g.name] and g.remaining > 0 then return true end
        end
        return false
    end

    -- next zone exists but sits above the rebirth requirement: zones cannot move without a rebirth
    local function zoneWaitsForRebirth()
        local nd, nr = state.nextZoneDir, state.nextRebirth
        return nd ~= nil and type(nr) == "table" and tonumber(nr.ZoneNumberRequired) ~= nil
            and (tonumber(nd.ZoneNumber) or 0) > tonumber(nr.ZoneNumberRequired)
    end

    local function stepWorld()
        if state.worldSwitching then
            if os.clock() - state.worldSwitchAt > 60 then state.worldSwitching = false end
            return true
        end
        if not CONFIG.AutoWorldTeleport or not state.world or not ready("worldCheck", 10) then return false end
        -- focused: a new world only once the rank needs a zone this world has run out of
        if rankFocused() and not (state.rank.blockedByZone and (state.nextZoneDir == nil or state.nextZoneDir.WorldNumber ~= state.world)) then
            return false
        end
        if not isfn(G.TeleportMapCmds, "CanTeleportToWorldRaw") then return false end
        local target = nil
        for w = state.world + 1, state.world + 3 do
            if gv(G.TeleportMapCmds.CanTeleportToWorldRaw, w) == true then target = w else break end
        end
        if target then return worldTeleport(target) end
        return false
    end

    local function stepRebirth()
        if not CONFIG.AutoRebirth or not isfn(G.RebirthCmds, "GetNextRebirth") or not ready("rebirth", 8) then return end
        -- a rebirth resets every zone: focused, only when the rank asks for it or zones the rank needs wait on it
        if rankFocused() and not (state.rank.blockedByRebirth or (rankNeedsZones() and zoneWaitsForRebirth())) then return end
        local nr = state.nextRebirth
        if type(nr) ~= "table" or nr._id == nil then return end
        local need = tonumber(nr.ZoneNumberRequired)
        if not need or (state.maxOwnedNumber or 0) < need then return end
        setDoing("Rebirthing")
        local ok, res, msg = gcall(G.RebirthCmds.Rebirth, nr._id)
        if ok and res then
            state.counters.rebirths += 1
            state.lastProgressAt = os.clock()
            farmZoneSig = ""
            log("rebirth %s", tostring(nr._id))
        else
            delayKey("rebirth", 30)
            log("rebirth failed: %s", tostring(msg or res))
        end
    end

    local function stepZone()
        if not CONFIG.AutoZones or not ready("zone", 2) then return end
        if rankFocused() and not rankNeedsZones() then return end
        local id, dir = state.nextZoneId, state.nextZoneDir
        if not (id and dir) then return end
        if state.world and dir.WorldNumber ~= state.world then return end -- next world: stepWorld handles it
        local nr = state.nextRebirth
        if type(nr) == "table" and tonumber(nr.ZoneNumberRequired) and (tonumber(dir.ZoneNumber) or 0) > tonumber(nr.ZoneNumberRequired) then
            return -- rebirth first
        end
        if isfn(G.ZoneCmds, "HasCompletedNextZoneQuests") and gv(G.ZoneCmds.HasCompletedNextZoneQuests) == false then return end
        local price = type(G.Balancing) == "table" and isfn(G.Balancing, "CalcGatePrice") and gv(G.Balancing.CalcGatePrice, dir) or nil
        if not canAfford(dir.Currency or worldCurrencyId(), price) then return end
        setDoing("Buying " .. zoneLabel(id))
        local hopped = false
        if state.zoneNeedsHop and isfn(G.ZonesUtil, "GetInteractFolder") then
            local folder = gv(G.ZonesUtil.GetInteractFolder, id)
            local gate = typeof(folder) == "Instance" and folder:FindFirstChild("Gate") or nil
            if gate and gate:IsA("BasePart") then
                state.busy = true
                local hrp = getHRP()
                local dir_ = hrp and (hrp.Position - gate.Position) or Vector3.zero
                local back = dir_.Magnitude > 1 and dir_.Unit * 8 or Vector3.new(0, 0, 8)
                hopped = moveTo(gate.Position + back + Vector3.new(0, 3, 0)) -- our side of the gate
                task.wait(0.35)
            end
        end
        local ok, res, msg = netInvoke("Zones_RequestPurchase", id)
        if hopped or state.busy then
            state.busy = false
            state.forceEnsure = true
        end
        state.zoneNeedsHop = not (ok and res) and not hopped
        if ok and res then
            state.counters.zones += 1
            state.lastProgressAt = os.clock()
            farmZoneSig = ""
            state.forceEnsure = true
            log("bought zone %s", tostring(id))
        else
            delayKey("zone", 15)
            log("zone %s failed: %s", tostring(id), tostring(msg or res))
        end
    end

    local function gatePrice(dir)
        if not dir or type(G.Balancing) ~= "table" or not isfn(G.Balancing, "CalcGatePrice") then return nil end
        local p = gv(G.Balancing.CalcGatePrice, dir)
        return type(p) == "number" and p or nil
    end

    -- Coins held back for the next zone (0 when the zone cannot be bought anyway).
    local function zoneReserve()
        local nd = state.nextZoneDir
        if not CONFIG.AutoZones or not nd or state.gate then return 0, nil end
        if rankFocused() and not rankNeedsZones() then return 0, nil end -- not saving for a zone we will not buy
        if state.world and nd.WorldNumber ~= state.world then return 0, nil end
        local nr = state.nextRebirth
        if type(nr) == "table" and tonumber(nr.ZoneNumberRequired) and (tonumber(nd.ZoneNumber) or 0) > tonumber(nr.ZoneNumberRequired) then
            return 0, nil
        end
        return gatePrice(nd) or 0, nd.Currency or worldCurrencyId()
    end

    -- What side spending (eggs, upgrades) may use: everything above the zone reserve, and never less than a
    -- quarter of the balance so rank goals still move while saving.
    local function spendable(cur, ignoreReserve)
        local bal = currencyOf(cur)
        if ignoreReserve then return bal end
        local reserve, rcur = zoneReserve()
        if rcur ~= cur or reserve <= 0 then return bal end
        return math.max(bal - reserve, bal * math.clamp(tonumber(CONFIG.HatchShare) or 0, 0, 1))
    end

    local function wantsGoal(name)
        for _, g in ipairs(state.goals) do
            if g.name == name and g.remaining > 0 then return true end
        end
        return false
    end

    local function stepSlots()
        local save = getSave()
        if not save then return end
        if (CONFIG.AutoBuyPetSlots or wantsGoal("EQUIP_PET")) and ready("petSlot", 20) and isfn(G.RankCmds, "GetMaxPurchasableEquipSlots") then
            local bought = tonumber(save.PetSlotsPurchased) or 0
            local maxSlots = tonumber(gv(G.RankCmds.GetMaxPurchasableEquipSlots)) or 0
            if bought < maxSlots then
                local idx = bought + 1
                local price = type(G.Balancing) == "table" and isfn(G.Balancing, "CalcPetSlotPrice") and gv(G.Balancing.CalcPetSlotPrice, idx) or nil
                if canAfford("Diamonds", price) and machineAllowed("EquipSlotsMachine") then
                    setDoing("Buying pet slot " .. idx)
                    local ok, res, msg = withMachine("EquipSlotsMachine", netInvoke, "EquipSlotsMachine_RequestPurchase", idx)
                    if ok and res then
                        clearStrike("machine:EquipSlotsMachine")
                        state.lastProgressAt = os.clock()
                        delayKey("equipBest", 2)
                    elseif ok ~= nil then
                        strike("machine:EquipSlotsMachine", msg or res)
                    end
                end
            end
        end
        if CONFIG.AutoBuyEggSlots and ready("eggSlot", 20) and isfn(G.EggSlotBundles, "Next") and isfn(G.RankCmds, "GetMaxPurchasableEggSlots") then
            local bought = tonumber(save.EggSlotsPurchased) or 0
            local bundle = gv(G.EggSlotBundles.Next, bought)
            local maxSlots = tonumber(gv(G.RankCmds.GetMaxPurchasableEggSlots)) or 0
            if type(bundle) == "table" and tonumber(bundle.End) and bundle.End <= maxSlots then
                local price = nil
                if type(G.Balancing) == "table" and isfn(G.Balancing, "CalcEggSlotPrice") then
                    price = 0
                    for i = bundle.Start, bundle.End do
                        local p = gv(G.Balancing.CalcEggSlotPrice, i)
                        if type(p) ~= "number" then price = nil break end
                        price += p
                    end
                end
                if canAfford("Diamonds", price) and machineAllowed("EggSlotsMachine") then
                    setDoing("Buying egg slots")
                    local ok, res, msg = withMachine("EggSlotsMachine", netInvoke, "EggHatchSlotsMachine_RequestPurchase", bundle.End)
                    if ok and res then
                        clearStrike("machine:EggSlotsMachine")
                        maxHatchCache.at = -1e9
                        state.lastProgressAt = os.clock()
                    elseif ok ~= nil then
                        strike("machine:EggSlotsMachine", msg or res)
                    end
                end
            end
        end
    end

    -- best-zone eggs must be unlocked once before they can be bought
    local unlockedEggs = {}
    local function stepEggUnlock()
        if not ready("eggUnlock", 6) or not (isfn(G.EggCmds, "IsUnlocked") and isfn(G.EggsUtil, "GetZoneEggNumber")) then return end
        local zn = zoneNumber(state.farmZone)
        if not zn then return end
        local n = gv(G.EggsUtil.GetZoneEggNumber, zn)
        local info = type(n) == "number" and eggInfo(n) or nil
        if not info or not info.id or unlockedEggs[info.id] or isBlocked("eggUnlock:" .. info.id) then return end
        if gv(G.EggCmds.IsUnlocked, info.id) == true then unlockedEggs[info.id] = true return end
        local pos = eggPosition(n)
        setDoing("Unlocking " .. tostring(info.name))
        if pos then
            state.busy = true
            moveTo(pos + Vector3.new(0, 3, 6))
            task.wait(0.4)
        end
        netInvoke("Eggs_RequestUnlock", info.id)
        task.wait(0.4)
        state.busy = false
        state.forceEnsure = true
        if gv(G.EggCmds.IsUnlocked, info.id) == true then
            unlockedEggs[info.id] = true
        else
            strike("eggUnlock:" .. info.id)
        end
    end

    -- A new account has no pets until the "Pick your pet!" choice is sent; without it nothing can farm
    -- and coins drain into zones. The game's Starter GUI sends this same call (default "Cat") and closes
    -- its own tab once the save flag flips.
    local function stepStarterPet()
        local save = getSave()
        if not save or save.PickedStarterPet or not ready("starterPet", 10) then return end
        setDoing("Picking the starter pet")
        local ok, res = netInvoke("Pick Starter Pets", "Cat")
        if ok and res then
            log("starter pet picked")
            state.hatchedSinceEquip = true
            petAt = -1e9
        else
            report("starter pet", tostring(res))
        end
    end

    local function stepFreeGifts()
        if not (CONFIG.AutoFreeGifts or wantsGoal("FREE_GIFT")) or not ready("gifts", 20) or type(G.FreeGifts) ~= "table" then return end
        local save = getSave()
        if not save then return end
        local t = tonumber(save.FreeGiftsTime) or 0
        local redeemed = type(save.FreeGiftsRedeemed) == "table" and save.FreeGiftsRedeemed or {}
        for key, gift in pairs(G.FreeGifts) do
            local id = type(gift) == "table" and (tonumber(gift.Id) or tonumber(key)) or nil
            if id and t >= (tonumber(gift.WaitTime) or math.huge) and not table.find(redeemed, id) then
                local ok, res = netInvoke("Redeem Free Gift", id)
                if ok and res then
                    state.counters.items += 1
                    setDoing("Free gift " .. id)
                else
                    -- a refused gift is retried every 20 s forever otherwise
                    delayKey("gifts", 600)
                end
                task.wait(0.3)
            end
        end
    end

    local function stepTimedRewards()
        if not (CONFIG.AutoTimedRewards or wantsGoal("CLAIM_FREE_DIAMONDS")) or not ready("timed", 30) or type(G.TimedRewards) ~= "table" then return end
        local save = getSave()
        if not save then return end
        local stamps = type(save.TimedRewardTimestamps) == "table" and save.TimedRewardTimestamps or {}
        local serverNow = workspace:GetServerTimeNow()
        for id, def in pairs(G.TimedRewards) do
            if not state.alive then return end
            local key = "timed:" .. tostring(id)
            if type(def) == "table" and type(def.MachineName) == "string" and not isBlocked(key)
                and vipAllowed(id) and machineAllowed(def.MachineName) then
                local last = stamps[id]
                if (not last or serverNow - last > (tonumber(def.Cooldown) or math.huge)) and machinePosition(def.MachineName) then
                    setDoing("Claiming " .. tostring(id))
                    local ok, res, msg = withMachine(def.MachineName, netInvoke, "DailyRewards_Redeem", id)
                    if ok and res then
                        clearStrike(key)
                        state.counters.items += 1
                    else
                        strike(key, msg or res) -- a VIP-room machine says so once, then it is left alone for an hour
                    end
                    task.wait(0.3)
                end
            end
        end
    end

    local function stepCraftAndItems()
        if not ready("craft", CONFIG.CraftTick) then return end
        local order = {}
        for _, g in ipairs(state.goals) do
            if g.remaining > 0 and g.supported then order[#order + 1] = g end
        end
        local function rank(g)
            if g.source == "gate" then return 0 end
            if GOLD_GOALS[g.name] then return 1 end
            if RAINBOW_GOALS[g.name] then return 2 end
            return 3
        end
        table.sort(order, function(a, b)
            local ra, rb = rank(a), rank(b)
            if ra ~= rb then return ra < rb end
            return a.Stars > b.Stars
        end)
        local fodder = nil
        for _, g in ipairs(order) do
            if not state.alive or state.worldSwitching then return end
            local name, result = g.name, nil
            local ok = true
            if GOLD_GOALS[name] and CONFIG.AutoCraft then
                ok, result = pcall(handleGold, g)
            elseif RAINBOW_GOALS[name] and CONFIG.AutoCraft then
                ok, result = pcall(handleRainbow, g)
            elseif CONFIG.AutoItems then
                if name == "USE_POTION" then ok = pcall(handleUsePotion, g)
                elseif name == "UPGRADE_POTION" then ok = pcall(handleUpgrade, g, true)
                elseif name == "UPGRADE_ENCHANT" then ok = pcall(handleUpgrade, g, false)
                elseif name == "USE_FRUIT" then ok = pcall(handleUseFruit, g)
                elseif name == "USE_FLAG" then ok = pcall(handleUseFlag, g)
                end
            end
            if not ok then log("handler %s errored: %s", tostring(name), tostring(result)) result = nil end
            if type(result) == "table" and fodder == nil then
                result.gate = g.source == "gate"
                fodder = result
            end
        end
        state.craftHatch = fodder
    end

    local function stepEquipBest()
        if not CONFIG.AutoEquipBest or not isfn(G.PetCmds, "EquipBest") then return end
        if (state.hatchedSinceEquip and ready("equipBestHatch", 30)) or ready("equipBest", 180) then
            state.hatchedSinceEquip = false
            gcall(G.PetCmds.EquipBest)
            petAt = -1e9
        end
    end

    local function stepEnchants()
        local want = CONFIG.EquipEnchants
        if type(want) ~= "table" or #want == 0 or not ready("enchants", 20) then return end
        if not (isfn(G.EnchantCmds, "Get") and isfn(G.EnchantCmds, "Equip") and isfn(G.EnchantCmds, "GetEquipped")) then return end
        local equipped = gv(G.EnchantCmds.GetEquipped)
        local have = {}
        if type(equipped) == "table" then for _, uid in pairs(equipped) do have[uid] = true end end
        local maxSlots = isfn(G.RankCmds, "GetMaxEquippedEnchants") and tonumber(gv(G.RankCmds.GetMaxEquippedEnchants)) or 0
        local count = 0
        for _ in pairs(have) do count += 1 end
        for _, id in ipairs(want) do
            if maxSlots > 0 and count >= maxSlots then return end
            local owned = gv(G.EnchantCmds.Get, id)
            if type(owned) == "table" then
                local bestUid, bestTier = nil, -1
                for _, item in pairs(owned) do
                    if type(item) == "table" and isfn(item, "GetUID") and isfn(item, "GetTier") then
                        local uid, tier = gv(item.GetUID, item), gv(item.GetTier, item)
                        if type(uid) == "string" and type(tier) == "number" and tier > bestTier then bestUid, bestTier = uid, tier end
                    end
                end
                if bestUid and not have[bestUid] then
                    gcall(G.EnchantCmds.Equip, bestUid)
                    have[bestUid] = true
                    count += 1
                    task.wait(0.3)
                end
            end
        end
    end

    local eggNeedsHop = {}       -- egg id -> true once a far purchase failed and a near one worked
    local function hatchNote(text)
        state.hatchNote, state.hatchNoteAt = text, os.clock()
    end

    local zoneByNumber = nil
    local function zoneIdByNumber(num)
        if not zoneByNumber then
            zoneByNumber = {}
            for id, z in pairs(type(G.Zones) == "table" and G.Zones or {}) do
                local zn = type(z) == "table" and tonumber(z.ZoneNumber) or nil
                if zn then zoneByNumber[zn] = id end
            end
        end
        return zoneByNumber[num]
    end

    -- World 3 egg capsules load only near the player (verified live: the best egg's capsule was missing until
    -- its zone was visited). Stand in the egg's zone once; the capsule position is then remembered.
    local function visitEggZone(egg)
        local num = tonumber(type(egg.dir) == "table" and egg.dir.zoneNumber)
        if not num or not ready("eggVisit:" .. tostring(egg.id), 90) then return false end
        local zoneId = zoneIdByNumber(num)
        if not zoneId then return false end
        setDoing("Finding " .. tostring(egg.name))
        state.busy = true
        serverZoneTeleport(zoneId)
        local t0 = os.clock()
        repeat task.wait(0.5) until eggPosition(egg.n) ~= nil or os.clock() - t0 > 10 or not state.alive
        state.busy = false
        state.forceEnsure = true
        local found = eggPosition(egg.n) ~= nil
        log("egg %s %s after visiting %s", tostring(egg.id), found and "found" or "still missing", tostring(zoneId))
        return found
    end

    local function stepHatch()
        local req = state.plan.hatch
        if not req or not CONFIG.AutoHatch or os.clock() < state.hatchBackoff or inInstance() then return end
        -- a zone teleport lands after its request returns and would pull us off the egg mid-purchase
        -- (live: refusals clustered 3-5 s after each zone teleport, while a 1.5 s-settled buy works up to 85 studs)
        if os.clock() - (state.zoneTpAt or -1e9) < 6 then return end
        local egg = req.egg
        if not (egg and egg.id) or isBlocked("hatch:" .. egg.id) then return end
        local amount = maxHatch()
        if req.cap then amount = math.min(amount, req.cap) end
        local cur = egg.dir.currency or worldCurrencyId()
        local price = eggPrice(egg)
        if price and price > 0 then
            -- goals hatch with everything; strength hatching only with coins the next zone does not need
            local budget = req.strength and spendable(cur, false) or currencyOf(cur)
            local afford = math.floor(budget / price)
            if afford < 1 then
                hatchNote({ kind = currencyOf(cur) >= price and "zone" or "egg", have = budget, need = price, cur = cur })
                return
            end
            amount = math.min(amount, afford)
        end
        amount = math.max(1, math.floor(amount))
        local hrp = getHRP()
        local pos = eggPosition(egg.n)
        -- found: the next tick hatches, after the zone teleport has settled (the 6 s guard above)
        if not pos and visitEggZone(egg) then return end
        if not pos then
            -- unknown position used to read as distance 0: no hop, and a refusal every 5 s forever
            strike("hatch:" .. egg.id, "egg position unknown")
            hatchNote({ kind = "text", text = "egg not in this world: " .. tostring(egg.name) })
            return
        end
        local dist = hrp and (hrp.Position - pos).Magnitude or 0
        local hopped = false
        -- the server accepted buys at 85 studs and refused at 131 (live), so beyond HatchMaxDistance we hop first
        if dist > 12 and (eggNeedsHop[egg.id] or state.hatchNeedsHop or dist > CONFIG.HatchMaxDistance) and state.hopFailedEgg ~= egg.id then
            state.busy = true
            hopped = moveTo(pos + Vector3.new(0, 3, 6))
            task.wait(0.25)
        end
        setDoing(string.format("Hatching %s x%d", tostring(egg.name), amount))
        local ok, res, msg = netInvoke("Eggs_RequestPurchase", egg.id, amount)
        if hopped or state.busy then
            state.busy = false
            state.forceEnsure = true
        end
        if ok and res == true then
            if hopped then eggNeedsHop[egg.id] = true end -- remember: this egg wants us close
            clearStrike("hatch:" .. egg.id)
            state.hatchFails = 0
            state.hatchNeedsHop = false
            state.hopFailedEgg = nil
            state.hatchNote = nil
            state.counters.hatched += amount
            state.hatchedSinceEquip = true
            state.lastProgressAt = os.clock()
            if req.cap then
                req.cap -= amount
                if req.cap <= 0 then state.plan.hatch = nil end -- brain rebuilds from the save within a second
            end
            return
        end
        state.hatchFails += 1
        state.hatchBackoff = os.clock() + ({ 1, 2, 5 })[math.min(state.hatchFails, 3)]
        local m = ok and msg or res -- pcall error text when the invoke itself failed
        local text = string.lower(tostring(m or ""))
        log("hatch %s x%d failed (dist %d, hop %s, zone tp %.0fs ago): %s", tostring(egg.id), amount, math.floor(dist),
            tostring(hopped), math.min(999, os.clock() - (state.zoneTpAt or -1e9)), tostring(m))
        -- World 2 says it in words ("You need more Tech Coins to buy this egg!", live); World 1 sends nothing
        if ok and (m == nil or string.find(text, "need more", 1, true)) then
            -- the game's own auto hatch reads "no message" as "not enough currency"
            maxHatchCache.at = -1e9
            hatchNote({ kind = "egg", have = currencyOf(cur), need = (price or 0) * amount, cur = cur })
        elseif string.find(text, "full", 1, true) or string.find(text, "storage", 1, true) or string.find(text, "inventory", 1, true) then
            strike("hatch:" .. egg.id, m)
            hatchNote({ kind = "text", text = "pet storage full" })
        else
            -- any other refusal: try once next to the egg, then stop hopping for this egg
            if hopped then state.hopFailedEgg = egg.id end
            state.hatchNeedsHop = not hopped and state.hopFailedEgg ~= egg.id
            if hopped then
                strike("hatch:" .. egg.id, m)
                hatchNote({ kind = "text", text = "egg refused: " .. tostring(m) })
            end
        end
    end

    -- Empty zone for a while: ask the server where it has us. A different zone means the character
    -- position did not replicate, so re-enter through the game's zone teleport.
    local function stepSync()
        -- Map_GetReplicatedState returns nothing (verified live), so there is no server-side zone to compare.
        -- A farm zone that stays empty means our position may not have replicated: re-enter it.
        local since = state.noTargetsSince
        if not since or os.clock() - since < 20 or not state.farmZone or not ready("sync", 60) then return end
        log("zone empty %ds: re-entering %s", math.floor(os.clock() - since), tostring(state.farmZone))
        setDoing("Re-syncing zone")
        serverZoneTeleport(state.farmZone)
        state.forceEnsure = true
    end

    -- Potions and fruit: farming speed for free. Potion tiers an UPGRADE_POTION goal needs are kept.
    local function stepBoosts()
        if not ready("boosts", 15) then return end
        if CONFIG.AutoPotions and isfn(G.PotionCmds, "Has") then
            local keepTier = {}
            for _, g in ipairs(state.goals) do
                if g.name == "UPGRADE_POTION" and g.remaining > 0 then
                    local T = tonumber(goalParam(g, "PotionTier"))
                    if T then keepTier[T - 1] = true end
                end
            end
            for _, id in ipairs(CONFIG.BoostPotions) do
                if gv(G.PotionCmds.Has, id) == false then
                    local best = nil
                    for _, st in ipairs(stacks("Potion", function(item) return item.id == id end)) do
                        local tn = tonumber(st.item.tn) or 1
                        if not keepTier[tn] and (best == nil or tn > (tonumber(best.item.tn) or 1)) then best = st end
                    end
                    if best and netFire("Potions: Consume", best.uid, 1) then
                        state.counters.items += 1
                        setDoing("Potion: " .. id)
                        task.wait(0.3)
                    end
                end
            end
        end
        if CONFIG.AutoFruits and isfn(G.FruitCmds, "GetMaxConsume") then
            for _, st in ipairs(stacks("Fruit", function(item) return CONFIG.AllowShinyFruit or item.sh ~= true end)) do
                local n = math.min(tonumber(gv(G.FruitCmds.GetMaxConsume, st.uid)) or 0, st.amount)
                if n >= 1 and netFire("Fruits: Consume", st.uid, n) then
                    state.counters.items += n
                    setDoing("Eating fruit")
                    task.wait(0.3)
                end
            end
        end
    end

    -- Map upgrade stations (UpgradeCmds): cheapest affordable one first, one per pass.
    local function stepUpgrades()
        if not ((CONFIG.AutoUpgrades and not rankFocused()) or wantsGoal("MAP_UPGRADE")) or not ready("upgrades", 10) then return end
        if not (isfn(G.UpgradeCmds, "All") and isfn(G.UpgradeCmds, "CanInteractWith") and isfn(G.UpgradeCmds, "Purchase")) then return end
        local all = gv(G.UpgradeCmds.All)
        if type(all) ~= "table" then return end
        local best = nil
        for _, u in ipairs(all) do
            if type(u) == "table" and u.UpgradeID ~= nil and u.ZoneID ~= nil then
                local key = "upg:" .. tostring(u.UpgradeID) .. "@" .. tostring(u.ZoneID)
                if not isBlocked(key) and gv(G.UpgradeCmds.CanInteractWith, u.UpgradeID, u.ZoneID) == true then
                    local d = dget(G.Upgrades, u.UpgradeID)
                    local tier = tonumber(u.UpgradeTier)
                    local cost = d and tier and type(d.TierCosts) == "table" and tonumber(d.TierCosts[tier]) or nil
                    local curD = d and tier and type(d.TierCurrencies) == "table" and d.TierCurrencies[tier] or nil
                    local cur = type(curD) == "table" and curD._id or nil
                    if cost and cur and spendable(cur, wantsGoal("MAP_UPGRADE")) >= cost and (best == nil or cost < best.cost) then
                        best = { u = u, cost = cost, key = key }
                    end
                end
            end
        end
        if not best then return end
        local u = best.u
        local pos = nil
        pcall(function()
            local up = u.Model:FindFirstChild("Upgrade")
            pos = (up and up:IsA("BasePart") and up.Position) or u.Model:GetPivot().Position
        end)
        setDoing("Upgrade: " .. tostring(u.UpgradeID))
        local hopped = false
        local hrp = getHRP()
        if pos and hrp and (hrp.Position - pos).Magnitude > 20 then
            state.busy = true
            hopped = moveTo(pos + Vector3.new(0, 3, 5))
            task.wait(0.35)
        end
        local ok, res, msg = gcall(G.UpgradeCmds.Purchase, u.UpgradeID, u.ZoneID)
        if hopped or state.busy then
            state.busy = false
            state.forceEnsure = true
        end
        if ok and res then
            clearStrike(best.key)
            state.lastProgressAt = os.clock()
            log("upgrade %s @ %s", tostring(u.UpgradeID), tostring(u.ZoneID))
        else
            strike(best.key, msg or res)
        end
    end

    -- one failing step must never starve the ones after it
    local function run(name, fn)
        local ok, r = pcall(fn)
        if not ok then
            report(name, r)
            return nil
        end
        return r
    end

    workTick = function()
        if not state.ready or state.rejoining then return end
        if run("world", stepWorld) then return end
        if inInstance() then return end
        run("starter", stepStarterPet)
        run("sync", stepSync)
        run("rebirth", stepRebirth)
        run("zone", stepZone)
        run("hatch", stepHatch)
        run("gifts", stepFreeGifts)
        run("slots", stepSlots)
        run("eggUnlock", stepEggUnlock)
        run("timed", stepTimedRewards)
        run("craft", stepCraftAndItems)
        run("boosts", stepBoosts)
        run("upgrades", stepUpgrades)
        run("events", stepEvents)
        run("enchants", stepEnchants)
        run("equip", stepEquipBest)
    end

end

-- =====================================================================================
-- 13. Brain: snapshot, plan, status rows
-- =====================================================================================
local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
local function short(n)
    n = tonumber(n) or 0
    local neg = n < 0
    if neg then n = -n end
    local i = 1
    while n >= 1000 and i < #SUFFIX do
        n /= 1000
        i += 1
    end
    local s
    if i == 1 then
        s = tostring(math.floor(n))
    else
        s = string.gsub(string.format("%.1f%s", n, SUFFIX[i]), "%.0(%a+)$", "%1")
    end
    return neg and ("-" .. s) or s
end

local function clock(sec)
    sec = math.max(0, math.floor(sec))
    return string.format("%02d:%02d:%02d", sec // 3600, sec // 60 % 60, sec % 60)
end

local function hatchRequestFor(goal)
    local name = goal.name
    local egg = nil
    if name == "EGG" then
        local eggId = goalParam(goal, "EggID")
        egg = type(eggId) == "string" and eggForId(eggId) or nil
        if type(eggId) == "string" and not egg then return nil end -- that egg is not available here
    elseif name == "PET" then
        local petId = goalParam(goal, "PetID")
        if type(petId) == "string" then
            egg = eggForPet(petId)
            if not egg then return nil end
        end
    end
    egg = egg or bestEgg()
    if not egg then return nil end
    return { egg = egg, cap = EGG_COUNT_GOALS[name] and goal.remaining or nil, reason = goal.title, gate = goal.source == "gate" }
end

local function buildPlan()
    local plan = { hatch = nil, diamonds = false, chest = false }
    for _, g in ipairs(state.goals) do
        if g.remaining > 0 and g.supported then
            if HATCH_GOALS[g.name] and not plan.hatch then plan.hatch = hatchRequestFor(g) end
            if g.name == "DIAMOND_BREAKABLE" then plan.diamonds = true end
            if CHEST_GOALS[g.name] then plan.chest = true end
        end
    end
    if not plan.hatch and state.craftHatch and CONFIG.AutoHatch then
        local egg = state.craftHatch.egg or bestEgg()
        if egg then plan.hatch = { egg = egg, reason = "fodder", gate = state.craftHatch.gate } end
    end
    -- focused: coins stay for quest eggs (strength hatching resumes at max rank)
    if not plan.hatch and CONFIG.AutoHatch and (CONFIG.AlwaysHatch or (CONFIG.HatchForStrength and not rankFocused())) then
        local egg = bestEgg()
        if egg then plan.hatch = { egg = egg, reason = CONFIG.AlwaysHatch and "always" or "strength", strength = not CONFIG.AlwaysHatch } end
    end
    state.plan = plan
end

local function trackEarnings(save)
    local cid = worldCurrencyId()
    local e = state.earn
    if e.world ~= cid then
        e.world = cid
        e.coins.last, e.coins.gained, e.diamonds.last, e.diamonds.gained = nil, 0, nil, 0
        e.since = os.clock()
    end
    local function sample(bucket, value)
        if bucket.last ~= nil and value > bucket.last then
            bucket.gained += value - bucket.last
            state.lastEarnAt = os.clock()
        end
        bucket.last = value
    end
    sample(e.coins, currencyOf(cid))
    sample(e.diamonds, currencyOf("Diamonds"))
end

local function rate(bucket)
    local hours = math.max(60, os.clock() - state.earn.since) / 3600
    return bucket.gained / hours
end

local esc, paint, buildTask, buildRows, C_LABEL, C_DIM
do
    -- Rich-text pieces for the status screen (grey caps label, white value, dim separator).
    C_LABEL, C_DIM = "#8C8C8C", "#6E6E6E"
    local C_SEP, C_ACCENT = "#4A4A4A", "#A9A9FF"
    local SEP = string.format('<font color="%s">  \u{B7}  </font>', C_SEP) -- middle dot, escaped: source stays ASCII

    esc = function(v)
        return (string.gsub(tostring(v), "[&<>]", { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;" }))
    end
    paint = function(color, v)
        return string.format('<font color="%s">%s</font>', color, esc(v))
    end
    local function pair(label, value, color)
        local v = color and paint(color, value) or esc(value)
        return paint(C_LABEL, label) .. " " .. v
    end

    -- 17,902 below ten million, 12.3M above (keeps lines short on small screens)
    local function num(n)
        n = math.floor(tonumber(n) or 0)
        if math.abs(n) >= 1e7 then return short(n) end
        local s_ = tostring(math.abs(n))
        s_ = string.reverse((string.gsub(string.reverse(s_), "(%d%d%d)", "%1,")))
        s_ = string.gsub(s_, "^,", "")
        return (n < 0 and "-" or "") .. s_
    end

    local function zoneName(id)
        local z = zoneDir(id)
        return (z and z.ZoneName) or tostring(id or "?")
    end

    buildTask = function()
        if state.rejoining then return "Rejoining" end
        if state.worldSwitching then return state.doing or "Teleporting" end
        if state.doing and os.clock() - state.doingAt < 4 then return state.doing end
        if inInstance() then return "Waiting (inside an instance)" end
        local parts = {}
        parts[#parts + 1] = string.format("Farming %s (%d pets / %d targets)", zoneName(state.farmZone), state.petCount, state.farmTargets)
        local h = state.plan.hatch
        local note = state.hatchNote
        if note and os.clock() - (state.hatchNoteAt or 0) > 10 then note = nil end
        if note then
            if note.kind == "zone" then
                parts[#parts + 1] = string.format("eggs wait: saving for %s", zoneName(state.nextZoneId))
            elseif note.kind == "egg" then
                parts[#parts + 1] = string.format("eggs wait: %s/%s %s", short(note.have), short(note.need), currencyName(note.cur))
            else
                parts[#parts + 1] = tostring(note.text)
            end
        elseif h and h.egg then
            parts[#parts + 1] = string.format("Hatching %s", tostring(h.egg.name))
        end
        if state.plan.chest then parts[#parts + 1] = "waiting for chests" end
        return table.concat(parts, " - ")
    end

    -- Why the next zone is not owned yet, in one short phrase.
    local function nextZoneText(cid)
        local nd = state.nextZoneDir
        if not nd then return "all zones owned" end
        if state.worldBlocked then return string.format("World %d ready (set ScriptUrl)", state.worldBlocked) end
        if state.world and nd.WorldNumber ~= state.world then return string.format("World %s", tostring(nd.WorldNumber)) end
        if state.gate then
            return string.format("%s %s/%s", state.gate.title, num(state.gate.Progress), num(state.gate.Amount))
        end
        local nr = state.nextRebirth
        if type(nr) == "table" and tonumber(nr.ZoneNumberRequired) and (tonumber(nd.ZoneNumber) or 0) > tonumber(nr.ZoneNumberRequired) then
            return string.format("%s (rebirth first)", zoneName(state.nextZoneId))
        end
        local price = type(G.Balancing) == "table" and isfn(G.Balancing, "CalcGatePrice") and gv(G.Balancing.CalcGatePrice, nd) or nil
        return string.format("%s %s/%s", zoneName(state.nextZoneId), short(currencyOf(nd.Currency or cid)), price and short(price) or "?")
    end

    local petSlotCache = { v = nil, at = -1e9 }
    local function petSlots()
        if os.clock() - petSlotCache.at < 15 then return petSlotCache.v end
        petSlotCache.at = os.clock()
        local v = isfn(G.PetCmds, "GetMaxEquipped") and gv(G.PetCmds.GetMaxEquipped) or nil
        if type(v) == "number" then petSlotCache.v = math.floor(v) end
        return petSlotCache.v
    end

    -- rows[1..8]: name, rank, timer, currencies, slots, progress, step, tasks
    buildRows = function(save)
        local rows = state.rows
        local cid = worldCurrencyId()
        local info = state.rank
        rows[1] = esc(CONFIG.ScreenTitle ~= "" and CONFIG.ScreenTitle or (LocalPlayer and LocalPlayer.DisplayName) or "Hayami")
        if info then
            if info.isMax then
                rows[2] = pair("RANK", string.format("%d %s", info.number, tostring(info.title))) .. SEP .. paint(C_ACCENT, "MAX")
            else
                rows[2] = pair("RANK", string.format("%d %s", info.number, tostring(info.title)))
                    .. SEP .. pair("STARS", string.format("%s/%s", num(info.stars), num(info.totalStars)))
                    .. SEP .. pair("REWARDS", string.format("%d/%d", info.redeemedCount, #info.rewards))
            end
        else
            rows[2] = paint(C_LABEL, "loading")
        end
        rows[3] = clock(os.time() - state.sessionStart)
        local zoneText = zoneName(state.farmZone) .. ((state.world and state.world > 1) and (" W" .. state.world) or "")
        rows[4] = pair(string.upper(currencyName(cid)), num(state.earn.coins.last))
            .. SEP .. pair("DIAMONDS", num(state.earn.diamonds.last))
            .. SEP .. pair("ZONE", zoneText, C_ACCENT)
        rows[5] = pair("HATCHED", num(state.counters.hatched))
            .. SEP .. pair("EGG SLOT", tostring(maxHatch()))
            .. SEP .. pair("PET SLOT", tostring(petSlots() or "?"))
        rows[6] = pair("REBIRTH", tostring(save.Rebirths or 0))
            .. SEP .. pair("NEXT", nextZoneText(cid))
            .. SEP .. pair("RATE", string.format("+%s/h", short(rate(state.earn.coins))))
        if state.lastError and os.clock() - (state.lastErrorAt or 0) < 20 then
            rows[7] = paint(C_LABEL, "STEP") .. " " .. paint("#FF6B6B", "error " .. state.lastError)
        else
            rows[7] = paint(C_LABEL, "STEP") .. " " .. paint(C_DIM, buildTask())
        end
        -- every open goal, gate quest first; goals the script cannot do are dimmed
        local items = {}
        if info and info.isMax then
            items[1] = esc("max rank - farming best zone")
        end
        for _, g in ipairs(state.goals) do
            if g.remaining > 0 and #items < 6 then
                local title = (g.source == "gate" and "Gate: " or "") .. g.title
                local prog = string.format("%s/%s", num(g.Progress), num(g.Amount))
                if g.supported then
                    items[#items + 1] = esc(title) .. " " .. paint(C_LABEL, prog)
                else
                    items[#items + 1] = paint(C_DIM, title .. " " .. prog .. " (skip)")
                end
            end
        end
        if #items == 0 then items[1] = paint(C_DIM, "waiting for goals") end
        rows[8] = paint(C_LABEL, "TASKS") .. "  " .. table.concat(items, SEP)
    end
end

local rejoin -- forward

local function watchdog()
    local t = os.clock()
    if state.worldSwitching or state.rejoining then return end
    -- pets idle on an empty zone: re-seat the character first, rejoin later
    if CONFIG.AutoFarm and state.petCount > 0 and state.farmTargets == 0 then
        state.noTargetsSince = state.noTargetsSince or t
    else
        state.noTargetsSince = nil
    end
    local stallMin = tonumber(CONFIG.RejoinOnStallMinutes) or 0
    if stallMin > 0 then
        local idle = math.min(t - state.lastEarnAt, t - state.lastProgressAt)
        if idle > stallMin * 60 then rejoin("stalled " .. math.floor(idle) .. "s") return end
    end
    -- farming keeps earning while the work thread is stuck, so the stall check above cannot see this
    if state.workSince and t - state.workSince > 300 then rejoin("work step stuck " .. math.floor(t - state.workSince) .. "s") return end
    -- A server can stop spawning breakables in our zone for us (verified live: Melted River empty for 6+ min,
    -- other zones full, client creating them fine, re-entry refused "You are already here!", a zone round
    -- trip changed nothing; a new server farmed at once). Hatching keeps progress alive, so the stall check
    -- above never fires: a long-empty farm zone gets its own server hop.
    local emptyMin = tonumber(CONFIG.EmptyZoneRejoinMinutes) or 0
    if emptyMin > 0 and state.noTargetsSince and not inInstance() and t - state.noTargetsSince > emptyMin * 60 then
        rejoin("farm zone empty " .. math.floor(t - state.noTargetsSince) .. "s")
        return
    end
    local hours = tonumber(CONFIG.RejoinEveryHours) or 0
    if hours > 0 and t - state.bootClock > hours * 3600 then rejoin("scheduled") end
end

local function brainTick()
    local save = getSave()
    if not save then return end
    state.world = currentWorld()
    -- zones
    if isfn(G.ZoneCmds, "GetMaxOwnedZone") then
        local _, dir = gv(G.ZoneCmds.GetMaxOwnedZone)
        state.maxOwnedNumber = type(dir) == "table" and tonumber(dir.ZoneNumber) or state.maxOwnedNumber
    end
    if isfn(G.ZoneCmds, "GetNextZone") then
        local id, dir = gv(G.ZoneCmds.GetNextZone)
        state.nextZoneId = type(id) == "string" and id or nil
        state.nextZoneDir = type(dir) == "table" and dir or nil
    end
    state.nextRebirth = isfn(G.RebirthCmds, "GetNextRebirth") and gv(G.RebirthCmds.GetNextRebirth) or nil
    local zone = computeFarmZone(save)
    if zone ~= state.farmZone then
        state.farmZone = zone
        state.forceEnsure = true
        registryDirty = true
    end
    -- rank
    local info = readRank(save)
    if state.lastRank and info.number > state.lastRank then
        state.counters.ranks += info.number - state.lastRank
        state.claimAllTries = 0
        state.lastProgressAt = os.clock()
        table.clear(titleCache)
        log("rank up -> %d", info.number)
    end
    state.lastRank = info.number
    state.rank = info
    readGoals(save)
    claimRanks(info)
    buildPlan()
    trackEarnings(save)
    if ready("machineScan", 10) then rememberMachines() end
    watchdog()
    if gui and GUI.screen and GUI.screen.Visible then buildRows(save) end -- no string work while hidden
end

