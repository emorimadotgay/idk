            local screen = Instance.new("Frame")
            screen.Name = "Screen"
            screen.Size = UDim2.fromScale(1, 1)
            screen.BackgroundColor3 = Color3.new(0, 0, 0)
            screen.BorderSizePixel = 0
            screen.Active = true
            screen.Parent = sg
            GUI.screen = screen

            local scale = Instance.new("UIScale")
            scale.Parent = screen
            local function rescale()
                local cam = workspace.CurrentCamera
                local w = cam and cam.ViewportSize.X or 1280
                scale.Scale = w < 500 and 0.8 or (w > 1600 and 1.25 or 1)
            end
            rescale()
            if workspace.CurrentCamera then
                track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale))
            end

            local column = Instance.new("Frame")
            column.Name = "Column"
            column.AnchorPoint = Vector2.new(0.5, 0.5)
            column.Position = UDim2.fromScale(0.5, 0.48)
            column.Size = UDim2.new(1, -40, 0, 0)
            column.AutomaticSize = Enum.AutomaticSize.Y
            column.BackgroundTransparency = 1
            column.Parent = screen
            local layout = Instance.new("UIListLayout")
            layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            layout.Padding = UDim.new(0, 3)
            layout.Parent = column

            local function line(order, size, bold, color)
                local l = Instance.new("TextLabel")
                l.LayoutOrder = order
                l.BackgroundTransparency = 1
                l.Size = UDim2.new(1, 0, 0, size + 4)
