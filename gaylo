local STATE_FILE = nil
-- "Machine@PlaceId" -> { x, y, z, zone }. Machines stream in and out with their zone (MachineCmds.All
-- only lists loaded ones, verified live), so every machine is remembered once seen and survives rejoins.
local machineSeen = {}
-- "EggNumber@PlaceId" -> { x, y, z }: World 3 capsules stream in only near the player (see eggPosition)
local eggSeen = {}
local function stateFile()
    if not STATE_FILE and LocalPlayer then
        STATE_FILE = string.format("Hayami_PS99_%d.json", LocalPlayer.UserId) -- per account: many clients share one workspace
    end
    return STATE_FILE
end

persist = function()
    if not fsWrite or not stateFile() then return end
    pcall(function()
        fsWrite(stateFile(), HttpService:JSONEncode({
            version = VERSION,
            savedAt = os.time(),
            sessionStart = state.sessionStart,
            lastWorldSwitch = state.lastWorldSwitch,
            counters = state.counters,
            machines = machineSeen,
            eggs = eggSeen,
        }))
    end)
end

local function restore()
    if not (fsIsFile and fsRead and stateFile()) then return end
    local ok, data = pcall(function()
        if not fsIsFile(stateFile()) then return nil end
        return HttpService:JSONDecode(fsRead(stateFile()))
    end)
    if not ok or type(data) ~= "table" then return end
    state.lastWorldSwitch = tonumber(data.lastWorldSwitch) or 0
    if type(data.machines) == "table" then -- positions never go stale: kept regardless of the session gap
        for k, v in pairs(data.machines) do
            if type(k) == "string" and type(v) == "table" and tonumber(v[1]) and tonumber(v[2]) and tonumber(v[3]) then
                machineSeen[k] = v
            end
        end
    end
    if type(data.eggs) == "table" then
        for k, v in pairs(data.eggs) do
            if type(k) == "string" and type(v) == "table" and tonumber(v[1]) and tonumber(v[2]) and tonumber(v[3]) then
                eggSeen[k] = v
            end
        end
    end
    -- a gap under 15 minutes is the same session (world teleport / rejoin)
    if os.time() - (tonumber(data.savedAt) or 0) < 900 then
        state.sessionStart = tonumber(data.sessionStart) or state.sessionStart
        if type(data.counters) == "table" then
            for k, v in pairs(data.counters) do
                if type(v) == "number" and state.counters[k] ~= nil then state.counters[k] = v end
            end
        end
    end
end

local function serializeValue(v, depth)
    local t = type(v)
    if t == "boolean" or t == "number" then return tostring(v) end
    if t == "string" then return string.format("%q", v) end
    if t == "table" and depth < 3 then
        local parts = {}
        if #v > 0 or next(v) == nil then
            for i = 1, #v do
                local s = serializeValue(v[i], depth + 1)
                if s then parts[#parts + 1] = s end
            end
        else
            for k, vv in pairs(v) do
                if type(k) == "string" and string.match(k, "^[%a_][%w_]*$") then
                    local s = serializeValue(vv, depth + 1)
                    if s then parts[#parts + 1] = k .. "=" .. s end
                end
            end
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    return nil
end

-- Queues this script for the next place (world teleport / rejoin). Returns true when something is queued
-- or autoexec covers it.
local function queueSelf()
    if CONFIG.AutoexecInstalled then return true end
    if state.queued then return true end
    if not queueTeleport then return false end
    local parts = {}
    for k, v in pairs(CONFIG) do
        local s = serializeValue(v, 0)
        if s then parts[#parts + 1] = k .. "=" .. s end
    end
    local prefix = "getgenv().HayamiConfig={" .. table.concat(parts, ",") .. "};"
    local body = nil
    if CONFIG.ScriptUrl ~= "" then
        body = string.format("loadstring(game:HttpGet(%q))()", CONFIG.ScriptUrl)
    elseif CONFIG.WorkspaceFile ~= "" and fsIsFile then
        local ok, exists = pcall(fsIsFile, CONFIG.WorkspaceFile)
        if ok and exists then
            body = string.format("local f, e = loadstring(readfile(%q)); assert(f, e); f()", CONFIG.WorkspaceFile)
        end
    end
    if not body and CONFIG.ReexecSource ~= "" then body = CONFIG.ReexecSource end
    if not body then return false end
    -- a failed re-exec (e.g. a compile error) must say why instead of vanishing inside the pcall
    local ok = pcall(queueTeleport, prefix .. "local ok, err = pcall(function() " .. body
        .. " end) if not ok then warn(\"[Hayami] re-exec failed: \" .. tostring(err)) end")
    state.queued = ok
    return ok
end

