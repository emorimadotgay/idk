-- The main chunk is close to Luau's 200-locals-per-function limit, and executors that compile
-- without optimization (Delta: loadstring at -O0) count every local, constants included.
-- Helpers used by one section live in do-blocks; check with `luau-compile -O0 HayamiPS99.lua`.
local setIdentity, getIdentity, queueTeleport, setFps, hookFn, getSenv, getConns, getHui
local fsIsFile, fsRead, fsWrite
do
    local function firstFn(...)
        for i = 1, select("#", ...) do
            local f = select(i, ...)
            if type(f) == "function" then return f end
        end
        return nil
    end

    local synLib = rawget(genv, "syn")
    local fluxusLib = rawget(genv, "fluxus")
    local function libFn(lib, name)
        return type(lib) == "table" and lib[name] or nil
    end

    setIdentity = firstFn(setthreadidentity, set_thread_identity, setidentity, libFn(synLib, "set_thread_identity"))
    getIdentity = firstFn(getthreadidentity, get_thread_identity, getidentity, libFn(synLib, "get_thread_identity"))
    queueTeleport = firstFn(queue_on_teleport, libFn(synLib, "queue_on_teleport"), libFn(fluxusLib, "queue_on_teleport"))
    setFps = firstFn(setfpscap, set_fps_cap)
    hookFn = firstFn(hookfunction, hookfunc, replaceclosure)
    getSenv = firstFn(getsenv)
    getConns = firstFn(getconnections, get_signal_cons)
    getHui = firstFn(gethui, get_hidden_gui)
    fsIsFile, fsRead, fsWrite = firstFn(isfile), firstFn(readfile), firstFn(writefile)
end

local EXEC_IDENTITY = 8
if getIdentity then
    local ok, v = pcall(getIdentity)
    if ok and type(v) == "number" then EXEC_IDENTITY = v end
end

-- Runs fn at identity 2 (game modules check the caller) and restores the executor identity.
local function gcall(fn, ...)
    if type(fn) ~= "function" then return false, "not a function" end
    if setIdentity then pcall(setIdentity, 2) end
    local r = table.pack(pcall(fn, ...))
    if setIdentity then pcall(setIdentity, EXEC_IDENTITY) end
    return table.unpack(r, 1, r.n)
end

local function gv(fn, ...)
    local ok, a, b, c, d = gcall(fn, ...)
    if ok then return a, b, c, d end
    return nil
end

local function isfn(mod, name)
    return type(mod) == "table" and type(mod[name]) == "function"
end

-- Game directories raise on unknown keys; rawget never does.
local function dget(t, k)
    if type(t) ~= "table" or k == nil then return nil end
    return rawget(t, k)
end

