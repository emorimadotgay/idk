            end
            restoreFns[#restoreFns + 1] = function() u.GetPower = o end
        end)
        patch("InstancingCmds", function(i)
            local o = i.Get
            if type(o) ~= "function" then error("no Get") end
            i.Get = function(...)
                local r = o(...)
                if CONFIG.SuperMagnet and state.alive and type(r) == "table" and type(r.config) == "table" then
                    r.config.SuperMagnet = true
                end
                return r
            end
            restoreFns[#restoreFns + 1] = function() i.Get = o end
