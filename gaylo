        track(stopBtn.MouseButton1Click:Connect(function() Stop() end))

        -- RightCtrl toggles the whole overlay
        track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == CONFIG.GuiToggleKey and gui then
                gui.Enabled = not gui.Enabled
            end
        end))
    end)
end

local slotCache = { at = -1e9, egg = nil, pet = nil }
local function readSlots()
    local now = os.clock()
    if slotCache.egg ~= nil and now - slotCache.at < 30 then return slotCache.egg, slotCache.pet end
    if isfn(G.EggCmds, "GetMaxHatch") then
        local v = gval(G.EggCmds.GetMaxHatch)
        if type(v) == "number" and v >= 1 then slotCache.egg = math.floor(v) end
    end
    if isfn(G.PetCmds, "GetMaxEquipped") then
        local v = gval(G.PetCmds.GetMaxEquipped)
        if type(v) == "number" and v >= 1 then slotCache.pet = math.floor(v) end
    end
    slotCache.at = now
    return slotCache.egg, slotCache.pet
end

-- currency/zone lookups are the expensive part: cache them for a second
local statCache = { at = -1e9, coins = nil, diamonds = nil, zone = nil }
local function statValues()
    local now = os.clock()
    if now - statCache.at < 1 then
        return statCache.coins, statCache.diamonds, statCache.zone
    end
    local coins, diamonds = statCache.coins, statCache.diamonds
    if isfn(G.CurrencyCmds, "Get") then
        coins = gval(G.CurrencyCmds.Get, "Coins")
        diamonds = gval(G.CurrencyCmds.Get, "Diamonds")
    end
    local zoneName = statCache.zone
    if isfn(G.ZoneCmds, "GetMaxOwnedZone") then
        local z = gval(G.ZoneCmds.GetMaxOwnedZone)
        if type(z) == "table" then z = z._id end
        if type(z) == "string" and #z > 0 then
            zoneName = z
        end
    end
    if type(zoneName) ~= "string" then
        zoneName = bestZoneName()
    end
    statCache.at, statCache.coins, statCache.diamonds, statCache.zone = now, coins, diamonds, zoneName
    return coins, diamonds, zoneName
end

-- one-line task digest: first three unfinished goals plus a "+N" tail
local taskSig = ""
local taskText = ""
local function buildTaskLine()
    local goals = state.goals or {}
    local sigParts = {}
    for _, g in ipairs(goals) do
        sigParts[#sigParts + 1] = tostring(g.title) .. ":" .. tostring(g.Progress) .. ":" .. tostring(g.Amount)
            .. ":" .. tostring(g.remaining) .. ":" .. tostring(g.supported)
    end
    local sig = table.concat(sigParts, "|")
    if sig == taskSig and taskText ~= "" then
        return taskText
    end
    taskSig = sig
    local parts, shown = {}, 0
    for _, g in ipairs(goals) do
        if (tonumber(g.remaining) or 0) > 0 then
            shown += 1
            if #parts < 3 then
                local titleColor = "#8997a8"
                local progColor = "#566473"
                if g.supported == false then
                    titleColor = "#f6767a"
                elseif #parts == 0 then
                    titleColor = "#d2e6fa"
                    progColor = "#a4c9f4"
                end
                parts[#parts + 1] = string.format('<font color="%s">%s</font> <font color="%s">%s/%s</font>',
                    titleColor, esc(short(g.title or "?", 26)), progColor, int(g.Progress), int(g.Amount))
            end
        end
    end
    if shown == 0 then
        taskText = '<font color="#566473">TASKS</font>   <font color="#8997a8">no active tasks</font>'
    else
        local extra = shown > 3 and string.format('   <font color="#566473">+%d</font>', shown - 3) or ""
        taskText = '<font color="#566473">TASKS</font>   ' .. table.concat(parts, '   <font color="#37424f">·</font>   ') .. extra
    end
    return taskText
end

