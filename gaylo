local function esc(text)
    return (tostring(text or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function formatTime(total)
    total = math.max(0, math.floor(total))
    return string.format("%02d:%02d:%02d", math.floor(total / 3600), math.floor(total / 60) % 60, total % 60)
end

local function fmtn(n)
    n = math.floor(tonumber(n) or 0)
    return (tostring(n):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

local function short(text, limit)
    text = tostring(text or "")
    if #text <= limit then return text end
    local cut = math.max(1, limit - 2)
    if utf8 and utf8.offset then
        local ok, offset = pcall(utf8.offset, text, cut + 1)
        if ok and offset then cut = offset - 1 end
    end
    return text:sub(1, math.max(1, cut)) .. ".."
end

