local function getHRP()
    local ch = LocalPlayer and LocalPlayer.Character
    return ch and ch:FindFirstChild("HumanoidRootPart") or nil
end

local moveTo
do
    -- OptimizeMap deletes zone ground (egg pads, machines), so a teleport there ends in free fall and
    -- the server answers "You are too far away" (verified live: no floor within 300 studs under an egg).
    -- One invisible pad goes under every teleport target; the character itself is never anchored.
    local pad
    local function placePad(pos)
        if not (pad and pad.Parent) then
            pad = Instance.new("Part")
            pad.Name = "HayamiPad"
            pad.Size = Vector3.new(14, 1, 14)
            pad.Anchored = true
            pad.CanCollide = true
            pad.CanTouch = false
            pad.CanQuery = false
            pad.Transparency = 1
            pad.Parent = workspace
            restoreFns[#restoreFns + 1] = function()
                if pad then pad:Destroy() pad = nil end
            end
        end
        pad.CFrame = CFrame.new(pos - Vector3.new(0, 3.5, 0)) -- top face at foot height (root part ~3 studs up)
    end

    moveTo = function(pos)
        local hrp = getHRP()
        if not hrp then return false end
        pcall(placePad, pos)
        pcall(function()
            if hrp.Anchored then hrp.Anchored = false end -- an anchored root part stops replicating: the server would keep the old position
            hrp.CFrame = CFrame.new(pos)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
        return true
    end
end

