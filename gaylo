local function findPath(path, timeout)
    local inst = RS:FindFirstChild("Library") or RS:WaitForChild("Library", timeout)
    for _, name in ipairs(path) do
        if not inst then return nil end
        inst = inst:FindFirstChild(name) or inst:WaitForChild(name, timeout)
    end
    return inst
end

loadModule = function(key, path, timeout)
    if G[key] ~= nil then return G[key] end
    local okFind, inst = pcall(findPath, path, timeout)
    if not okFind or not inst then return nil end
    local ok, mod = gcall(require, inst)
    if ok and mod ~= nil then G[key] = mod return mod end
    return nil
end

local function directory(name)
    if type(G.Directory) ~= "table" then return nil end
    local ok, t = gcall(function() return G.Directory[name] end)
    if ok and type(t) == "table" then return t end
    return nil
end

